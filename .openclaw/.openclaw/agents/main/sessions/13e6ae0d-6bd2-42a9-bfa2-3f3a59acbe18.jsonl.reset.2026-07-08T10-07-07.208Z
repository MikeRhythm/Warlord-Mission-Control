Left Side) */}\n            <aside className=\"w-64 bg-gradient-to-b from-[#111317]/80 to-[#0A0B0D]/95 backdrop-blur-md border border-[#D4AF37]/20 shadow-[inset_0_1px_1px_rgba(212,175,55,0.08)] rounded-xl p-4 text-white flex flex-col\">\n              <h2 className=\"text-[#D4AF37] font-mono tracking-wider border-b border-[#D4AF37]/30 pb-2 mb-4 text-sm font-semibold uppercase\">\n                Live Activity Feed\n              </h2>\n              <ul className=\"flex-1 space-y-2 overflow-y-auto\">\n                <li className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                  Charlie: Setup local LLM environment\n                </li>\n                <div className=\"border-t border-[#E5E7EB]/10 my-3\" />\n                <li className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                  Tess: Finalized volatility scan parameters\n                </li>\n                <div className=\"border-t border-[#E5E7EB]/10 my-3\" />\n                <li className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                  Roxy: Updated dashboard color palette\n                </li>\n                <div className=\"border-t border-[#E5E7EB]/10 my-3\" />\n                <li className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                  Jack: Configured WebSocket bridge\n                </li>\n                <div className=\"border-t border-[#E5E7EB]/10 my-3\" />\n                <li className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                  System: Gateway health check passed\n                </li>\n              </ul>\n            </aside>\n\n            {/* KANBAN BOARD (Main Area) */}\n            <section className=\"flex flex-1 space-x-4\">\n              {/* BACKLOG COLUMN */}\n              <div className=\"bg-gradient-to-b from-[#111317]/80 to-[#0A0B0D]/95 backdrop-blur-md border border-[#D4AF37]/20 shadow-[inset_0_1px_1px_rgba(212,175,55,0.08)] rounded-xl p-4 text-white flex flex-col\">\n                <h2 className=\"text-[#D4AF37] font-mono tracking-wider border-b border-[#D4AF37]/30 pb-2 mb-4 text-sm font-semibold uppercase\">\n                  Backlog\n                </h2>\n                <div className=\"flex-1 space-y-2 overflow-y-auto\">\n                  <div className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                    <h3 className=\"font-semibold text-white mb-1\">Charlie</h3>\n                    <p className=\"text-white/80 text-sm\">Setup local LLM environment</p>\n                  </div>\n                  <div className=\"border-t border-[#E5E7EB]/10 my-3\" />\n                  <div className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                    <h3 className=\"font-semibold text-white mb-1\">Tess</h3>\n                    <p className=\"text-white/80 text-sm\">Configure Tailwind CSS for High Finance design</p>\n                  </div>\n                </div>\n              </div>\n\n              {/* IN PROGRESS COLUMN */}\n              <div className=\"bg-gradient-to-b from-[#111317]/80 to-[#0A0B0D]/95 backdrop-blur-md border border-[#D4AF37]/20 shadow-[inset_0_1px_1px_rgba(212,175,55,0.08)] rounded-xl p-4 text-white flex flex-col\">\n                <h2 className=\"text-[#D4AF37] font-mono tracking-wider border-b border-[#D4AF37]/30 pb-2 mb-4 text-sm font-semibold uppercase\">\n                  In Progress\n                </h2>\n                <div className=\"flex-1 space-y-2 overflow-y-auto\">\n                  <div className=\"bg-[#0F172A]/50 backdrop-blur-md rounded-xl p-4 text-white border border-[#E5E7EB]/25\">\n                    <h3 className=\"font-semibold text-white mb-1\">Roxy</h3>