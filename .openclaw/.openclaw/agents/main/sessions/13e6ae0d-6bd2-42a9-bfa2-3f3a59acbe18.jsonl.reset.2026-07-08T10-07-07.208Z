{"type":"message","id":"48708c60","parentId":"17a8d3ec","timestamp":"2026-07-07T18:29:01.804Z","message":{"role":"toolResult","toolCallId":"call-9444f2aa-4e01-490c-8f14-c5cd5dcfbb9d","toolName":"read","content":[{"type":"text","text":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport { ProjectCards } from \"./ProjectCards\";\n\nexport default function RhythmNerveCenter() {\n const [mounted, setMounted] = useState(false);\n const [activeTab, setActiveTab] = useState(\"projects\");\n const [selectedProject, setSelectedProject] = useState(null);\n const [showNewProjectForm, setShowNewProjectForm] = useState(false);\n\n useEffect(() => {\n setMounted(true);\n }, []);\n\n if (!mounted) return null;\n\n const projects = [\n { id: \"supapack\", name: \"Rhythm WASP AI Supa Pack\", lead: \"Charlie\", stage: \"ACTIVE_EXECUTION\", progress: 68, blocker: \"Local memory graph sync latency\" },\n { id: \"dashboard\", name: \"Nerve Center Control Panel\", lead: \"Roxy\", stage: \"ACTIVE_EXECUTION\", progress: 45, blocker: \"Port collision patch stability\" },\n { id: \"madothi\", name: \"Chief Madothi Fund Campaign\", lead: \"Jack\", stage: \"STAGING\", progress: 15, blocker: \"Webhook authorization\" }\n ];\n\n return (\n <main className=\"min-h-screen bg-[#0A0C10] text-white font-mono flex flex-col select-none p-6\">\n <header className=\"border-b border-[#DAA520]/20 pb-4 flex justify-between items-center\">\n <div>\n <h1 className=\"text-[#DAA520] font-bold tracking-widest text-lg\">RHYTHM NERVE CENTER</h1>\n <p className=\"text-gray-400 text-xs mt-1\">SYSTEM STATE: LOCALHOST // BASE 1</p>\n </div>\n </header>\n <div className=\"mt-6 flex-1\">\n <ProjectCards\n projects={projects}\n selectedProject={selectedProject}\n setSelectedProject={setSelectedProject}\n setShowNewProjectForm={setShowNewProjectForm}\n />\n </div>\n </main>\n );\n}"}],"isError":false,"timestamp":1783448941800}}
