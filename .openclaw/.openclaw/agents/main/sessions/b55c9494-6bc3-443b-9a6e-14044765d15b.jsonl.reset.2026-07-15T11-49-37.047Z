SUCCESS] Layouts compiled to: ${queuePath}`);\n}\n\ntry {\n const leads = executeHunterSourcing();\n executeRoxyCopywriter(leads);\n console.log(\"\\n[STATUS] Initial pipeline check complete.\");\n} catch (error) {\n console.error(\"[CRITICAL SYSTEM FAULT]\", error.message);\n}"},"partialArgs":"{\"path\":\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\outreach_engine.js\",\"content\":\"const fs = require('fs');\\nconst path = require('path');\\n\\nconst baseDirectory = 'C:\\\\\\\\Users\\\\\\\\MikeT\\\\\\\\Projects\\\\\\\\Chief Madithi\\\\\\\\';\\n\\nconst childProfiles = [\\n { name: \\\"Innocent Robert\\\", grade: \\\"Grade 4\\\", bio: \\\"Father was a fisherman who tragically drowned in the lake. Hoping to continue schooling.\\\" },\\n { name: \\\"Queen Choice\\\", grade: \\\"Form 1\\\", bio: \\\"Loves English and reading storybooks. Aspires to become a teacher.\\\" },\\n { name: \\\"Peggy Choice\\\", grade: \\\"Form 1\\\", bio: \\\"Enjoys helping at home. Favorite subject is Life Skills. Hopes to become a nurse.\\\" },\\n { name: \\\"Gracious Choice\\\", grade: \\\"Form 4\\\", bio: \\\"Loves soccer and Mathematics. Dreams of playing for Malawis national team.\\\" },\\n { name: \\\"Eledi Chifundo\\\", grade: \\\"Form 1\\\", bio: \\\"Quiet and thoughtful. Enjoys Life Skills and Reading. Dreams of becoming a teacher.\\\" },\\n { name: \\\"Proud Obu\\\", grade: \\\"Form 1\\\", bio: \\\"Intelligent and ambitious. Wants to build a future that uplifts his community.\\\" },\\n { name: \\\"Tamandani Msukwa\\\", grade: \\\"Form 3\\\", bio: \\\"Loves Mathematics and Science. Hopes to study medicine one day.\\\" },\\n { name: \\\"Clement Mawera\\\", grade: \\\"Form 1\\\", bio: \\\"Enjoys Mathematics and drawing. Wants to paint and create curios to sell to visitors.\\\" },\\n { name: \\\"Precious George\\\", grade: \\\"Form 2\\\", bio: \\\"Natural curiosity about how things work. Hopes to become a mechanic.\\\" },\\n { name: \\\"Precious Phiri\\\", grade: \\\"Form 1\\\