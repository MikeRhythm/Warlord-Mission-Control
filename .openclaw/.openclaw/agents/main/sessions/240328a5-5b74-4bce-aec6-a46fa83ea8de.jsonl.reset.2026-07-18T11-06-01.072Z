    </h1>\\n        </div>\\n        \\n        {/* Context Selector Alignment Framework */}\\n        <div className=\\\"flex items-center space-x-4\\\">\\n          <span className=\\\"text-[11px] text-rhythm-sage-metallic uppercase tracking-wider\\\">Context Selector:</span>\\n          <div className=\\\"relative\\\">\\n            <select \\n              value={context}\\n              onChange={(e) => setContext(e.target.value as ProjectContext)}\\n              className=\\\"bg-rhythm-glass-specular border border-rhythm-slate-reflection/40 text-[#C5A059] font-mono text-xs rounded-sm px-4 py-2 outline-none cursor-pointer hover:border-rhythm-gold-liquid/40 transition-colors duration-200 uppercase tracking-wide appearance-none pr-8 font-bold\\\"\\n            >\\n              <option value=\\\"OVERALL_GROUP\\\">🌐 Overall Group</option>\\n              <option value=\\\"CHIEF_MADOTHI\\\">🦁 Chief Madothi</option>\\n              <option value=\\\"DEFEND_YOUR_FAITH\\\">🛡️ Defend Faith</option>\\n              <option value=\\\"MYTHOLOGY_SUBS\\\">🏛️ Mythology Subs</option>\\n              <option value=\\\"STEDT_TYRONE\\\">📈 STEDT Tyrone</option>\\n            </select>\\n            <div className=\\\"absolute right-3 top-3.5 pointer-events-none text-rhythm-gold-liquid text-[9px]\\\">▼</div>\\n          </div>\\n        </div>\\n      </header>\\n\\n      {/* Laser-Etched Horizontal Accent Rail */}\\n      <div className=\\\"h-[1px] w-full bg-gradient-to-r from-transparent via-rhythm-gold-liquid/40 to-transparent\\\" />\\n\\n      {/* ==================== FIXED TWO-COLUMN VIEWPORT MATRIX ==================== */}\\n      <div className=\\\"flex-1 flex w-full overflow-hidden\\\">\\n        \\n        {/* NAVIGATION SIDEBAR PANEL */}\\n        <aside className=\\\"w-64 bg-rhythm-charcoal-matte border-r border-rhythm-slate-reflection/20 flex flex-col justify-between p-4 z-40\\\">\\n          <div className=\\\"space-y-1\\\">\\n            <div className=\\\"text-[10px] uppercase tracking-[0.2em] text-rhythm-sage-metallic px-3 mb-3 font-bold\\\">\\n              Mission Control Views\\n            </div>\\n            \\n            {[\\n              { id: 'KANBAN', label: '🗂️ Kanban Board' },\\n              { id: 'CALENDAR', label: '📅 Calendar / Cron' },\\n              { id: 'PROJECTS', label: '📂 Projects Hub' },\\n              { id: 'BOARDROOM', label: '👥 The Boardroom' },\\n              { id: 'CAMPAIGNS', label: '📡 Campaign Suites' },\\n              { id: 'OBSIDIAN', label: '🧠 Obsidian Graph' },\\n              { id: 'PAPERCLIP', label: '📎 Paperclip Ledger' },\\n              { id: 'SECURITY', label: '🛡️ Security Inspector' },\\n            ].map((tab) => (\\n              <button\\n                key={tab.id}\\n                onClick={() => setActiveScreen(tab.id as ActiveScreen)}\\n                className={`w-full text-left font-mono text-xs px-3 py-2.5 rounded-sm tracking-wide uppercase transition-all duration-150 flex items-center justify-between ${\\n                  activeScreen === tab.id \\n                    ? 'bg-rhythm-glass-specular border-l-2 border-rhythm-goldenrod-core text-[#F8FAFC]' \\n                    : 'text-rhythm-silver-mist hover:bg-rhythm-glass-specular/40 hover:text-[#E2E8F0]'\\n                }`}\\n              >\\n                <span>{tab.label}</span>\\n                {activeScreen === tab.id && <span className=\\\"text-[10px] text-rhythm-gold-liquid\\\">◀</span>}\\n              </button>\\n            ))}\\n          </div>\\n\\n          {/* Telemetry Base Plate */}\\n          <div className=\\\"bg-rhythm-obsidian-deep border border-rhythm-slate-reflection/20 p-3 rounded-sm\\\">\\n            <div className=\\\"text-[9px] text-rhythm-sage-metallic uppercase tracking-wider mb-1\\\">Grid Security</div>\\n            <div className=\\\"flex justify-between text-[10px]\\\">\\n              <span className=\\\"text-rhythm-silver-mist\\\">Node ID:</span>\\n              <span className=\\\"text-[#C5A059] font-bold\\\">BASE_1</span>\\n            </div>\\n            <div className=\\\"flex justify-between text-[10px] mt-0.5\\\">\\n              <span className=\\\"text-rhythm-silver-mist\\\">Status:</span>\\n              <span className=\\\"text-[#10B981] font-bold\\\">VERIFIED</span>\\n            </div>\\n          </div>\\n        </aside>\\n\\n        {/* ACTIVE CANVAS MAIN INTERACTIVE VIEWPORT */}\\n        <main className=\\\"flex-1 h-full overflow-y-auto bg-rhythm-obsidian-deep p-6 relative\\\">\\n          \\n          {/* Header Layout Telemetry Track */}\\n          <div className=\\\"mb-4 flex items-center justify-between border-b border-rhythm-slate-reflection/10 pb-3\\\">\\n            <div>\\n              <div className=\\\"text-[10px] text-rhythm-sage-metallic uppercase tracking-widest font-bold\\\">Workspace Viewport</div>\\n              <h2 className=\\\"text-[#E2E8F0] tracking-[0.05em] text-lg font-bold uppercase mt-0.5\\\">\\n                {activeScreen} 🛰️ <span className=\\\"text-[#C5A059] ml-2\\\">// {contextLabels[context]}</span>\\n              </h2>\\n            </div>\\n            <div className=\\\"text-right text-[11px] text-rhythm-silver-mist font-bold\\\">\\n              System Cycle: <span className=\\\"text-rhythm-goldenrod-core\\\">2026.07</span>\\n            </div>\\n          </div>\\n\\n          {/* Conditional rendering based on activeScreen */}\\n          {activeScreen === 'KANBAN' ? (\\n            <KanbanBoard context={context} />\\n          ) : (\\n            <>\\n              {/* Dynamic Environment Routing Constraint Notice */}\\n              <div className=\\\"bg-rhythm-charcoal-matte border border-rhythm-slate-reflection/30 backdrop-blur-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] rounded-sm p-4\\\">\\n                <div className=\\\"flex items-start space-x-3\\\">\\n                  <span className=\\\"text-rhythm-goldenrod-core text-base\\\">⚠️</span>\\n                