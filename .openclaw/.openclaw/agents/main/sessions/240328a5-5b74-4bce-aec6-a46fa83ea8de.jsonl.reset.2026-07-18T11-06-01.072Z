{"type":"message","id":"c00ae285","parentId":"c748b778","timestamp":"2026-07-17T19:57:35.239Z","message":{"role":"user","content":"'use client';\n\nimport React, { useState } from 'react';\n\n// Explicit type layout declarations for WASP context mapping\ntype ProjectContext = 'OVERALL_GROUP' | 'CHIEF_MADOTHI' | 'DEFEND_YOUR_FAITH' | 'MYTHOLOGY_SUBS' | 'STEDT_TYRONE';\ntype ActiveScreen = 'KANBAN' | 'CALENDAR' | 'PROJECTS' | 'BOARDROOM' | 'CAMPAIGNS' | 'OBSIDIAN' | 'PAPERCLIP' | 'SECURITY';\n\nexport default function MissionControlLayout() {\n  // Master navigation states\n  const [context, setContext] = useState<ProjectContext>('OVERALL_GROUP');\n  const [activeScreen, setActiveScreen] = useState<ActiveScreen>('KANBAN');\n\n  // Multi-project context map dictionary\n  const contextLabels: Record<ProjectContext, string> = {\n    OVERALL_GROUP: 'Overall Group Operations',\n    CHIEF_MADOTHI: 'Chief Madothi Children\\'s School & Feeding Fund',\n    DEFEND_YOUR_FAITH: 'Defend Your Faith Digital eBooks',\n    MYTHOLOGY_SUBS: 'Mythology Subscription Engines',\n    STEDT_TYRONE: 'STEDT Tyrone Commission Pipelines',\n  };\n\n  return (\n    <div className=\"w-screen h-screen overflow-hidden bg-rhythm-obsidian-deep text-rhythm-silver-mist font-mono flex flex-col select-none antialiased\">\n      \n      {/* ==================== MASTER TOP PANEL BLOCK ==================== */}\n      <header className=\"h-16 w-full bg-rhythm-charcoal-matte border-b border-rhythm-slate-reflection/20 px-6 flex items-center justify-between z-50\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"w-2 h-2 rounded-full bg-rhythm-goldenrod-core animate-pulse\" />\n          <h1 className=\"text-[#E2E8F0] uppercase tracking-[0.05em] font-bold text-sm\">\n            WASP // Rhythm Nerve Center\n          </h1>\n        </div>\n        \n        {/* Context Selector Alignment Framework */}\n        <div className=\"flex items-center space-x-4\">\n          <span className=\"text-[11px] text-rhythm-sage-metallic uppercase tracking-wider\">Context Selector:</span>\n          <div className=\"relative\">\n            <select \n              value={context}\n              onChange={(e) => setContext(e.target.value as ProjectContext)}\n              className=\"bg-rhythm-glass-specular border border-rhythm-slate-reflection/40 text-[#C5A059] font-mono text-xs rounded-sm px-4 py-2 outline-none cursor-pointer hover:border-rhythm-gold-liquid/40 transition-colors duration-200 uppercase tracking-wide appearance-none pr-8 font-bold\"\n            >\n              <option value=\"OVERALL_GROUP\">🌐 Overall Group</option>\n              <option value=\"CHIEF_MADOTHI\">🦁 Chief Madothi</option>\n              <option value=\"DEFEND_YOUR_FAITH\">🛡️ Defend Faith</option>\n              <option value=\"MYTHOLOGY_SUBS\">🏛️ Mythology Subs</option>\n              <option value=\"STEDT_TYRONE\">📈 STEDT Tyrone</option>\n            </select>\n            <div className=\"absolute right-3 top-3.5 pointer-events-none text-rhythm-gold-liquid text-[9px]\">▼</div>\n          </div>\n        </div>\n      </header>\n\n      {/* Laser-Etched Horizontal Accent Rail */}\n      <div className=\"h-[1px] w-full bg-gradient-to-r from-transparent via-rhythm-gold-liquid/40 to-transparent\" />\n\n      {/* ==================== FIXED TWO-COLUMN VIEWPORT MATRIX ==================== */}\n      <div className=\"flex-1 flex w-full overflow-hidden\">\n        \n        {/* NAVIGATION SIDEBAR PANEL */}\n        <aside className=\"w-64 bg-rhythm-charcoal-matte border-r border-rhythm-slate-reflection/20 flex flex-col justify-between p-4 z-40\">\n          <div className=\"space-y-1\">\n            <div className=\"text-[10px] uppercase tracking-[0.2em] text-rhythm-sage-metallic px-3 mb-3 font-bold\">\n              Mission Control Views\n            </div>\n            \n            {[\n              { id: 'KANBAN', label: '🗂️ Kanban Board' },\n              { id: 'CALENDAR', label: '📅 Calendar / Cron' },\n              { id: 'PROJECTS', label: '📂 Projects Hub' },\n              { id: 'BOARDROOM', label: '👥 The Boardroom' },\n              { id: 'CAMPAIGNS', label: '📡 Campaign Suites' },\n              { id: 'OBSIDIAN', label: '🧠 Obsidian Graph' },\n              { id: 'PAPERCLIP', label: '📎 Paperclip Ledger' },\n              { id: 'SECURITY', label: '🛡️ Security Inspector' },\n            ].map((tab) => (\n              <button\n                key={tab.id}\n                onClick={() => setActiveScreen(tab.id as ActiveScreen)}\n                className={`w-full text-left font-mono text-xs px-3 py-2.5 rounded-sm tracking-wide uppercase transition-all duration-150 flex items-center justify-between ${\n                  activeScreen === tab.id \n                    ? 'bg-rhythm-glass-specular border-l-2 border-rhythm-goldenrod-core text-[#F8FAFC]' \n                    : 'text-rhythm-silver-mist hover:bg-rhythm-glass-specular/40 hover:text-[#E2E8F0]'\n                }`}\n              >\n                <span>{tab.label}</span>\n                {activeScreen === tab.id && <span className=\"text-[10px] text-rhythm-gold-liquid\">◀</span>}\n              </button>\n            ))}\n          </div>\n\n          {/* Telemetry Base Plate */}\n          <div className=\"bg-rhythm-obsidian-deep border border-rhythm-slate-reflection/20 p-3 rounded-sm\">\n            <div className=\"text-[9px] text-rhythm-sage-metallic uppercase tracking-wider mb-1\">Grid Security</div>\n            <div className=\"flex justify-between text-[10px]\">\n              <span className=\"text-rhythm-silver-mist\">Node ID:</span>\n              <span className=\"text-[#C5A059] font-bold\">BASE_1</span>\n            </div>\n            <div className=\"flex justify-between text-[10px] mt-0.5\">\n              <span className=\"text-rhythm-silver-mist\">Status:</span>\n              <span className=\"text-[#10B981] font-bold\">VERIFIED</span>\n            </div>\n          </div>\n        </aside>\n\n        {/* ACTIVE CANVAS MAIN INTERACTIVE VIEWPORT */}\n        <main className=\"flex-1 h-full overflow-y-auto bg-rhythm-obsidian-deep p-6 relative\">\n          \n          {/* Header Layout Telemetry Track */}\n          <div className=\"mb-4 flex items-center justify-between border-b border-rhythm-slate-reflection/10 pb-3\">\n            <div>\n              <div className=\"text-[10px] text-rhythm-sage-metallic uppercase tracking-widest font-bold\">Workspace Viewport</div>\n              <h2 className=\"text-[#E2E8F0] tracking-[0.05em] text-lg font-bold uppercase mt-0.5\">\n                {activeScreen} 🛰️ <span className=\"text-[#C5A059] ml-2\">// {contextLabels[context]}</span>\n              </h2>\n            </div>\n            <div className=\"text-right text-[11px] text-rhythm-silver-mist font-bold\">\n              System Cycle: <span className=\"text-rhythm-goldenrod-core\">2026.07</span>\n            </div>\n          </div>\n\n          {/* Interactive Component Matrix Layout */}\n          <div className=\"space-y-6\">\n            \n            {/* Dynamic Environment Routing Constraint Notice */}\n            <div className=\"bg-rhythm-charcoal-matte border border-rhythm-slate-reflection/30 backdrop-blur-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] rounded-sm p-4\">\n              <div className=\"flex items-start space-x-3\">\n                <span className=\"text-rhythm-goldenrod-core text-base\">⚠️</span>\n                <div>\n                  <h4 className=\"text-xs text-[#F8FAFC] font-bold uppercase tracking-wide\">Data Matrix Isolation Enforced</h4>\n                  <p className=\"text-xs text-rhythm-silver-mist mt-1 leading-relaxed\">\n                    Viewport arrays and active execution pipes are partitioned down into the <span className=\"text-[#C5A059] font-bold\">{contextLabels[context]}</span> target folder environment rules. Cross-directory leakage blocks active.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Core Architectural Telemetry Module Row */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              \n              {/* Telemetry Process Component Card */}\n              <div className=\"bg-rhythm-charcoal-matte border border-rhythm-slate-reflection/30 backdrop-blur-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] rounded-sm p-4\">\n                <div className=\"border-b border-rhythm-slate-reflection/20 pb-2 mb-3 flex items-center justify-between\">\n                  <h3 className=\"text-xs font-bold text-[#C5A059] uppercase tracking-wider\">Operational Core</h3>\n                  <span className=\"text-[10px] text-[#10B981] bg-[#10B981]/10 px-2 py-0.5 rounded-sm font-bold\">ACTIVE</span>\n                </div>\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-xs border-b border-rhythm-slate-reflection/10 py-1\">\n                    <span className=\"text-rhythm-silver-mist\">Directory Scope:</span>\n                    <span className=\"text-[#F8FAFC] font-bold uppercase tracking-wide\">{context.toLowerCase()}_layer</span>\n                  </div>\n                  <div className=\"flex justify-between text-xs border-b border-rhythm-slate-reflection/10 py-1\">\n                    <span className=\"text-rhythm-silver-mist\">Heartbeat Loop Cadence:</span>\n                    <span className=\"text-rhythm-goldenrod-core font-bold\">120s Cron Interval</span>\n                  </div>\n                  <div className=\"flex justify-between text-xs py-1\">\n                    <span className=\"text-rhythm-silver-mist\">Computed Token Ceiling:</span>\n                    <span className=\"text-rhythm-silver-mist\">150K Limit Matrix</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Security Inspector State Card */}\n              <div className=\"bg-rhythm-charcoal-matte border border-rhythm-slate-reflection/30 backdrop-blur-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] rounded-sm p-4\">\n                <div className=\"border-b border-rhythm-slate-reflection/20 pb-2 mb-3 flex items-center justify-between\">\n                  <h3 className=\"text-xs font-bold text-[#C5A059] uppercase tracking-wider\">System Governance</h3>\n                  <span className=\"text-[10px] text-rhythm-goldenrod-core bg-rhythm-goldenrod-core/5 px-2 py-0.5 rounded-sm font-bold\">MONITORING</span>\n                </div>\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-xs border-b border-rhythm-slate-reflection/10 py-1\">\n                    <span className=\"text-rhythm-silver-mist\">Director Guard:</span>\n                    <span className=\"text-[#F8FAFC] font-bold\">CHARLIE // TESS</span>\n                  </div>\n                  <div className=\"flex justify-between text-xs border-b border-rhythm-slate-reflection/10 py-1\">\n                    <span className=\"text-rhythm-silver-mist\">Obsidian REST Port:</span>\n                    <span className=\"text-[#10B981] font-bold\">27123 (HTTP)</span>\n                  </div>\n                  <div className=\"flex justify-between text-xs py-1\">\n                    <span className=\"text-rhythm-silver-mist\">Injection Scan Status:</span>\n                    <span className=\"text-[#10B981] font-bold\">0 DEFECTS SECURE</span>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n\n            {/* Laser-Etched Grid Line Matrix Splitter */}\n            <div className=\"h-[1px] w-full bg-gradient-to-r from-transparent via-rhythm-gold-liquid/40 to-transparent\" />\n\n            {/* Terminal Live Activity Log Module */}\n            <div className=\"bg-rhythm-charcoal-matte border border-rhythm-slate-reflection/30 backdrop-blur-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] rounded-sm p-4\">\n              <div className=\"border-b border-rhythm-slate-reflection/20 pb-2 mb-3\">\n                <h3 className=\"text-xs font-bold text-[#E2E8F0] uppercase tracking-wider\">System Live Terminal Log Matrix</h3>\n              </div>\n              <div className=\"p-3 bg-rhythm-obsidian-deep rounded-sm border border-rhythm-slate-reflection/10 h-32 overflow-y-auto text-[11px] leading-relaxed space-y-1.5 text-rhythm-silver-mist font-mono\">\n                <p><span className=\"text-rhythm-sage-metallic\">[21:52:10]</span> <span className=\"text-[#10B981]\">SYSTEM</span> // High Finance visual skin parameters deployed cleanly.</p>\n                <p><span className=\"text-rhythm-sage-metallic\">[21:52:18]</span> <span className=\"text-rhythm-goldenrod-core\">CONFIG</span> // Tailwind dictionary variables linked across active runtime selectors.</p>\n                <p><span className=\"text-rhythm-sage-metallic\">[21:52:25]</span> <span className=\"text-[#10B981]\">SOCKET</span> // Local environment port handshake stable over Base 1 local subnet.</p>\n                <p><span className=\"text-rhythm-sage-metallic\">[21:52:32]</span> <span className=\"text-rhythm-silver-mist\">MATRIX</span> // Obsidian structural graph view mapped to context variable state: <span className=\"text-[#C5A059] font-bold\">{context}</span>.</p>\n              </div>\n            </div>\n\n          </div>\n        </main>\n      </div>\n    </div>\n  );\n}","timestamp":1784318249818,"idempotencyKey":"b74f4e1f-9990-4b5e-93a4-79aa9323ed35:user"}}
