{"type":"message","id":"200727a3","parentId":"2cb23068","timestamp":"2026-07-08T17:43:07.275Z","message":{"role":"toolResult","toolCallId":"call-8f1cd765-1fef-44ad-b126-6ada10b84f0b","toolName":"read","content":[{"type":"text","text":"﻿\"use client\";\n\nimport React, { useState } from 'react';\n\nconst views = ['Task Board', 'Cron Jobs', 'Projects', 'Memory', 'Docs', 'Team'];\n\nconst contentMap: Record<string, { title: string; body: string[] }> = {\n  'Task Board': {\n    title: 'Task Board',\n    body: ['Track the current sprint.', 'Move work across planning, progress, and review.']\n  },\n  'Cron Jobs': {\n    title: 'Cron Jobs',\n    body: ['Review scheduled automation.', 'Keep recurring tasks reliable and visible.']\n  },\n  'Projects': {\n    title: 'Projects',\n    body: ['Monitor active initiatives.', 'Group work by delivery milestone.']\n  },\n  'Memory': {\n    title: 'Memory',\n    body: ['Store important context.', 'Keep team notes easy to find.']\n  },\n  'Docs': {\n    title: 'Docs',\n    body: ['Centralize documentation.', 'Share standards and reference material.']\n  },\n  'Team': {\n    title: 'Team',\n    body: ['Coordinate contributors.', 'Stay aligned on ownership and priorities.']\n  }\n};\n\nexport default function DashboardPage() {\n  const [activeView, setActiveView] = useState('Task Board');\n\n  const obsidianBg = \"bg-[#0A0B0D] text-[#E5E7EB] min-h-screen font-mono p-6 flex flex-col gap-6\";\n  const outerContainerClass = \"border border-[#D4AF37]/45 bg-[#0F172A]/20 backdrop-blur-md rounded-2xl p-6 h-full flex flex-col\";\n  const headerClass = \"text-[#D4AF37] font-mono tracking-wider border-b border-[#D4AF37]/45 pb-2 mb-4 text-sm font-bold uppercase\";\n  const glassCardClass = \"bg-[#0F172A]/50 backdrop-blur-md border border-[#E5E7EB]/40 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] rounded-xl p-4 transition-all duration-200 hover:border-[#E5E7EB]/60\";\n  const secondaryText = \"text-xs text-[#E5E7EB]/60 mt-1 leading-relaxed\";\n\n  return (\n    <div className={obsidianBg}>\n      <div className=\"flex flex-col lg:flex-row gap-6 items-stretch flex-1\">\n        \n        {/* SIDEBAR NAVIGATION */}\n        <div className=\"w-full lg:w-64 border border-[#E5E7EB]/20 bg-[#111317]/90 rounded-2xl p-6 flex flex-col gap-2 shadow-2xl shrink-0\">\n          <div className=\"text-[#D4AF37] text-lg font-bold tracking-widest border-b border-[#E5E7EB]/10 pb-4 mb-4 text-center\">\n            RHYTHM APP\n          </div>\n          {views.map((view) => (\n            <button\n              key={view}\n              type=\"button\"\n              onClick={() => setActiveView(view)}\n              className={`w-full text-left px-4 py-3 rounded-xl font-medium tracking-wide transition-all duration-150 text-sm ${\n                activeView === view\n                  ? \"text-[#D4AF37] bg-[#D4AF37]/10 font-bold border-l-4 border-[#D4AF37] pl-3\"\n                  : \"text-[#E5E7EB]/50 hover:text-[#E5E7EB] hover:bg-white/5\"\n              }`}\n            >\n              {view}\n            </button>\n          ))}\n        </div>\n\n        {/* WORKSPACE AREA */}\n        <div className=\"flex-1 min-w-0\">\n          \n          {activeView === 'Task Board' && (\n            <div className=\"grid grid-cols-1 xl:grid-cols-4 gap-6 items-start h-full\">\n              <div className={outerContainerClass}>\n                <h2 className={headerClass}>Live Activity Feed</h2>\n                <div className=\"flex flex-col gap-3 overflow-y-auto max-h-[70vh]\">\n                  <div className={glassCardClass}><p className=\"text-xs font-bold text-[#E5E7EB]\">Charlie:</p><p className={secondaryText}>Setup local LLM environment</p></div>\n                  <div className={glassCardClass}><p className=\"text-xs font-bold text-[#E5E7EB]\">Tess:</p><p className={secondaryText}>Finalized volatility scan parameters</p></div>\n                  <div className={glassCardClass}><p className=\"text-xs font-bold text-[#E5E7EB]\">Roxy:</p><p className={secondaryText}>Updated dashboard color palette</p></div>\n                  <div className={glassCardClass}><p className=\"text-xs font-bold text-[#E5E7EB]\">Jack:</p><p className={secondaryText}>Configured WebSocket bridge</p></div>\n                </div>\n              </div>\n\n              <div className={outerContainerClass}>\n                <h2 className={headerClass}>Backlog</h2>\n                <div className={glassCardClass}>\n                  <p className=\"text-sm font-bold text-white\">Charlie</p>\n                  <p className={secondaryText}>{contentMap['Task Board'].body[0]}</p>\n                </div>\n              </div>\n\n              <div className={outerContainerClass}>\n                <h2 className={headerClass}>In Progress</h2>\n                <div className={glassCardClass}>\n                  <p className=\"text-sm font-bold text-white\">Roxy</p>\n                  <p className={secondaryText}>Deploy Nerve Center to Base 1</p>\n                </div>\n              </div>\n\n              <div className={outerContainerClass}>\n                <h2 className={headerClass}>Review</h2>\n                <div className={glassCardClass}>\n                  <p className=\"text-sm font-bold text-white\">Tess</p>\n                  <p className={secondaryText}>{contentMap['Task Board'].body[1]}</p>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {activeView === 'Cron Jobs' && (\n            <div className={outerContainerClass}>\n              <h2 className={headerClass}>Active Scheduled Heartbeats</h2>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                <div className={glassCardClass}>\n                  <div className=\"flex justify-between items-center border-b border-white/10 pb-2 mb-2\">\n                    <span className=\"text-xs font-bold text-white\">FX_VOLATILITY_SCAN</span>\n                    <span className=\"text-[10px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full font-bold\">Active</span>\n                  </div>\n                  <p className=\"text-xs text-[#E5E7EB]/80\">Interval: */5 * * * *</p>\n                  <p className={secondaryText}>{contentMap['Cron Jobs'].body[0]}</p>\n                </div>\n                <div className={glassCardClass}>\n                  <div className=\"flex justify-between items-center border-b border-white/10 pb-2 mb-2\">\n                    <span className=\"text-xs font-bold text-white\">AGENT_SYNC_HEARTBEAT</span>\n                    <span className=\"text-[10px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full font-bold\">Active</span>\n                  </div>\n                  <p className=\"text-xs text-[#E5E7EB]/80\">Interval: */1 * * * *</p>\n                  <p className={secondaryText}>{contentMap['Cron Jobs'].body[1]}</p>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {activeView === 'Projects' && (\n            <div className={outerContainerClass}>\n              <h2 className={headerClass}>Enterprise Project Register</h2>\n              <div className={glassCardClass}>\n                <h3 className=\"text-sm font-bold text-white\">Rhythm WASP AI Supa Pack</h3>\n                <p className={secondaryText}>{contentMap['Projects'].body[0]}</p>\n              </div>\n            </div>\n          )}\n\n          {activeView === 'Memory' && (\n            <div className={outerContainerClass}>\n              <h2 className={headerClass}>Operational Log Journal</h2>\n              <div className=\"p-3 border-l-2 border-[#D4AF37] bg-white/5 rounded-r-xl\">\n                <span className=\"text-[#D4AF37] font-bold\">[SYSTEM INIT]:</span>\n                <p className=\"text-[#E5E7EB]/80 text-xs mt-1\">{contentMap['Memory'].body[0]}</p>\n              </div>\n            </div>\n          )}\n\n          {activeView === 'Docs' && (\n            <div className={outerContainerClass}>\n              <h2 className={headerClass}>Architecture Documentation Repository</h2>\n              <div className={glassCardClass}>\n                <h3 className=\"text-sm font-bold text-white\">01_rules_of_engagement.md</h3>\n                <p className={secondaryText}>{contentMap['Docs'].body[0]}</p>\n              </div>\n            </div>\n          )}\n\n          {activeView === 'Team' && (\n            <div className={outerContainerClass}>\n              <h2 className={headerClass}>Director-Level Systems Organization</h2>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div className={glassCardClass}><h3 className=\"text-sm font-bold text-white\">Charlie</h3><p className={secondaryText}>Coding Lead (MQL4/MQL5 scripting).</p></div>\n                <div className={glassCardClass}><h3 className=\"text-sm font-bold text-white\">Tess</h3><p className={secondaryText}>Quant Analyst (Volatility scanning).</p></div>\n                <div className={glassCardClass}><h3 className=\"text-sm font-bold text-white\">Roxy</h3><p className={secondaryText}>UI/UX Director (Brand specs).</p></div>\n                <div className={glassCardClass}><h3 className=\"text-sm font-bold text-white\">Jack</h3><p className={secondaryText}>Backend Infrastructure (Server connections).</p></div>\n              </div>\n            </div>\n          )}\n\n        </div>\n      </div>\n    </div>\n  );\n}\r\n"}],"isError":false,"timestamp":1783532587272}}
