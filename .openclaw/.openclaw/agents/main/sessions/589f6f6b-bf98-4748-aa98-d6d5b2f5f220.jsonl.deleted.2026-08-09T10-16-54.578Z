{"type":"message","id":"b98aa676","parentId":"f718544e","timestamp":"2026-07-15T12:52:15.231Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call-16706a73-c9e5-4405-ad52-b075b9f19938","name":"write","arguments":{"path":"C:\\Users\\MikeT\\Projects\\Chief Madithi\\base1_status.ps1","action":"write","content":"# base1_status.ps1\n# Core health check script for Base 1 (Platform Focus)\n\nfunction Test-PortOpen($port) {\n    $tcpClient = New-Object System.Net.Sockets.TcpClient\n    try {\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\n        if (-not $success) { return $false }\n        $tcpClient.EndConnect($result) | Out-Null\n        $tcpClient.Close()\n        return $true\n    } catch { return $false }\n}\n\nfunction Test-Ollama {\n    # Try HTTP endpoint first\n    try {\n        $response = Invoke-WebRequest -Uri 'http://127.0.0.1:11434' -UseBasicParsing -TimeoutSec 2 -ErrorAction Stop\n        if ($response.StatusCode -eq 200) { return $true }\n    } catch {\n        # Fallback to 127.0.0.1:11434' -UseBasicParsing -TimeoutSec 2 -ErrorAction Stop\n        if ($response.StatusCode -eq 200) { return $true }\n    } catch {\n        # Fallback: check if ollama process\n        if (Get-Process -Name ollama -ErrorAction SilentlyContinue) { return $true }\n    }\n    return $false\n}\n\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\n\n# Corrected mission-control-app path\n$missionControlPath = 'C:\\Warlord_Inc\\Warlord_WASP\\.openclaw\\.openclaw\\workspace\\mission-control-app'\n$envPath = Join-Path $scriptDir '.env'\n\n$requiredPaths = @($missionControlPath, $envPath)\n\nWrite-Host \"=== Base 1 Health Check ===\" -ForegroundColor Cyan\n\n# Check directories/files\nforeach ($path in $requiredPaths) {\n    if (Test-Path -Path $path) {\n        Write-Host \"[OK]  $path\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] $path\" -ForegroundColor Red\n    }\n}\n\n# Check ports\n$portsToCheck = @(18789) # OpenClaw UI\nforeach ($port in $portsToCheck) {\n    if (Test-PortOpen -port $port) {\n        Write-Host \"[OK]  Port $port listening\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] Port $port not listening\" -ForegroundColor Red\n    }\n}\n\n# Check Ollama/qwen2.5\nif (Test-Ollama) {\n    Write-Host \"[OK]  Ollama/qwen2.5 service responding\" -ForegroundColor Green\n} else {\n    Write-Host \"[FAIL] Ollama/qwen2.5 not responding\" -ForegroundColor Red\n    Write-Host \"  Hint: Start Ollama service by running 'ollama serve' in a separate terminal.\" -ForegroundColor Yellow\n}\n\nWrite-Host \"===========================\" -ForegroundColor Cyan"},"partialArgs":"{\"path\":\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\base1_status.ps1\",\"action\":\"write\",\"content\":\"# base1_status.ps1\\n# Core health check script for Base 1 (Platform Focus)\\n\\nfunction Test-PortOpen($port) {\\n    $tcpClient = New-Object System.Net.Sockets.TcpClient\\n    try {\\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\\n        if (-not $success) { return $false }\\n        $tcpClient.EndConnect($result) | Out-Null\\n        $tcpClient.Close()\\n        return $true\\n    } catch { return $false }\\n}\\n\\nfunction Test-Ollama {\\n    # Try HTTP endpoint first\\n    try {\\n        $response = Invoke-WebRequest -Uri 'http://127.0.0.1:11434' -UseBasicParsing -TimeoutSec 2 -ErrorAction Stop\\n        if ($response.StatusCode -eq 200) { return $true }\\n    } catch {\\n        # Fallback to 127.0.0.1:11434' -UseBasicParsing -TimeoutSec 2 -ErrorAction Stop\\n        if ($response.StatusCode -eq 200) { return $true }\\n    } catch {\\n        # Fallback: check if ollama process\\n        if (Get-Process -Name ollama -ErrorAction SilentlyContinue) { return $true }\\n    }\\n    return $false\\n}\\n\\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\\n\\n# Corrected mission-control-app path\\n$missionControlPath = 'C:\\\\Warlord_Inc\\\\Warlord_WASP\\\\.openclaw\\\\.openclaw\\\\workspace\\\\mission-control-app'\\n$envPath = Join-Path $scriptDir '.env'\\n\\n$requiredPaths = @($missionControlPath, $envPath)\\n\\nWrite-Host \\\"=== Base 1 Health Check ===\\\" -ForegroundColor Cyan\\n\\n# Check directories/files\\nforeach ($path in $requiredPaths) {\\n    if (Test-Path -Path $path) {\\n        Write-Host \\\"[OK]  $path\\\" -ForegroundColor Green\\n    } else {\\n        Write-Host \\\"[FAIL] $path\\\" -ForegroundColor Red\\n    }\\n}\\n\\n# Check ports\\n$portsToCheck = @(18789) # OpenClaw UI\\nforeach ($port in $portsToCheck) {\\n    if (Test-PortOpen -port $port) {\\n        Write-Host \\\"[OK]  Port $port listening\\\" -ForegroundColor Green\\n    } else {\\n        Write-Host \\\"[FAIL] Port $port not listening\\\" -ForegroundColor Red\\n    }\\n}\\n\\n# Check Ollama/qwen2.5\\nif (Test-Ollama) {\\n    Write-Host \\\"[OK]  Ollama/qwen2.5 service responding\\\" -ForegroundColor Green\\n} else {\\n    Write-Host \\\"[FAIL] Ollama/qwen2.5 not responding\\\" -ForegroundColor Red\\n    Write-Host \\\"  Hint: Start Ollama service by running 'ollama serve' in a separate terminal.\\\" -ForegroundColor Yellow\\n}\\n\\nWrite-Host \\\"===========================\\\" -ForegroundColor Cyan\"}"}],"api":"openai-completions","provider":"nvidia","model":"nvidia/nemotron-3-super-120b-a12b","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784119911096,"responseId":"chatcmpl-373aa65f-29a7-4791-9372-f62ef2de318c"}}
