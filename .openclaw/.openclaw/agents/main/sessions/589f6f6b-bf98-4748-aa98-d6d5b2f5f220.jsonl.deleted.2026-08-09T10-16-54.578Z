{"type":"message","id":"dd5dc9fa","parentId":"602d5947","timestamp":"2026-07-15T19:47:03.976Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call-a90f7312-f11e-4f7f-a9fc-b363f1a288e3","name":"write","arguments":{"action":"write","content":"# research_ollama.ps1\n# 6-Pillar Intelligence Net filter using local Ollama (qwen2.5-coder:7b)\n\n# Configuration\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\n$ollamaEndpoint = \"http://localhost:11434/api/generate\"\n$modelName = \"qwen2.5-coder:7b\"\n$inputFile = Join-Path $scriptDir \"raw_feed.txt\"\n$outputFile = Join-Path $scriptDir \"research_brief.md\"\n$logFile = Join-Path $scriptDir \"research_ollama.log\"\n\nfunction Write-Log {\n    param([string]$message)\n    $timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\n    \"$timestamp $message\" | Out-File -FilePath $logFile -Append -Encoding utf8\n}\n\n# Ensure output file exists\nif (-not (Test-Path $outputFile)) {\n    New-Item -ItemType File -Path $outputFile -Force | Out-Null\n}\n\n# Define the judge prompt template (short)\n$judgePrompt = @\"\nYou are the WASP System Judge. Extract ONLY actionable, high-leverage nuggets that improve:\n1. Local Base 1 optimization/UI (performance, automation, dashboards).\n2. Automated SEO, lead gen, distribution (programmatic SEO, traffic, outreach).\n3. Specific range trading/smart money (15‑min range, order blocks, liquidity sweeps, institutional footprints).\n4. Online business models/high‑leverage monetization (AI monetization, builder‑distributor, micro‑communities, profit‑share).\nIgnore general tech/news without concrete, implementable insight.\nFor each chunk, reply with exactly one line:\n- If qualifies: ACCEPT: <2‑3 sentence technical summary>\n- Else: REJECT\nNo extra text.\n\"@\n\n# Function to query Ollama\nfunction Invoke-OllamaJudge {\n    param([string]$chunk)\n    $payload = @{\n        model  = $modelName\n        prompt = $judgePrompt + \"`n\" + $chunk\n        stream = $false\n    } | ConvertTo-Json -Depth 3\n\n    try {\n        $response = Invoke-RestMethod -Uri $ollamaEndpoint -Method Post -Body $payload -ContentType \"application/json\" -UseBasicParsing -TimeoutSec 120\n        $text = $response.response.Trim()\n        return $text\n    } catch {\n        Write-Log \"ERROR querying Ollama: $_\"\n        return \"ERROR\"\n    }\n}\n\n# Main processing\nif (Test-Path $inputFile) {\n    $content = Get-Content -Path $inputFile -Raw\n    # Split into chunks (double newline)\n    $chunks = $content -split \"`n`n\"\n    foreach ($chunk in $chunks) {\n        if ([string]::IsNullOrWhiteSpace($chunk)) { continue }\n        $result = Invoke-OllamaJudge -chunk $chunk.Trim()\n        if ($result -like \"ACCEPT:*\") {\n            $summary = $result.Substring(\"ACCEPT:\".length).Trim()\n            # Append to research_brief.md with a timestamp\n            $timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm\"\n            $line = \"[$timestamp] $summary\"\n            Add-Content -Path $outputFile -Value $line\n            Write-Log \"ACCEPTED: $summary\"\n        } elseif ($result -eq \"REJECT\") {\n            Write-Log \"REJECTED chunk\"\n        } else {\n            Write-Log \"UNEXPECTED RESPONSE: $result\"\n        }\n    }\n} else {\n    Write-Log \"Input file not found: $inputFile. No processing performed.\"\n}","path":"C:\\Users\\MikeT\\Projects\\WASP_Core_Update_Project\\research_ollama.ps1"},"partialArgs":"{\"action\":\"write\",\"content\":\"# research_ollama.ps1\\n# 6-Pillar Intelligence Net filter using local Ollama (qwen2.5-coder:7b)\\n\\n# Configuration\\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\\n$ollamaEndpoint = \\\"http://localhost:11434/api/generate\\\"\\n$modelName = \\\"qwen2.5-coder:7b\\\"\\n$inputFile = Join-Path $scriptDir \\\"raw_feed.txt\\\"\\n$outputFile = Join-Path $scriptDir \\\"research_brief.md\\\"\\n$logFile = Join-Path $scriptDir \\\"research_ollama.log\\\"\\n\\nfunction Write-Log {\\n    param([string]$message)\\n    $timestamp = Get-Date -Format \\\"yyyy-MM-dd HH:mm:ss\\\"\\n    \\\"$timestamp $message\\\" | Out-File -FilePath $logFile -Append -Encoding utf8\\n}\\n\\n# Ensure output file exists\\nif (-not (Test-Path $outputFile)) {\\n    New-Item -ItemType File -Path $outputFile -Force | Out-Null\\n}\\n\\n# Define the judge prompt template (short)\\n$judgePrompt = @\\\"\\nYou are the WASP System Judge. Extract ONLY actionable, high-leverage nuggets that improve:\\n1. Local Base 1 optimization/UI (performance, automation, dashboards).\\n2. Automated SEO, lead gen, distribution (programmatic SEO, traffic, outreach).\\n3. Specific range trading/smart money (15‑min range, order blocks, liquidity sweeps, institutional footprints).\\n4. Online business models/high‑leverage monetization (AI monetization, builder‑distributor, micro‑communities, profit‑share).\\nIgnore general tech/news without concrete, implementable insight.\\nFor each chunk, reply with exactly one line:\\n- If qualifies: ACCEPT: <2‑3 sentence technical summary>\\n- Else: REJECT\\nNo extra text.\\n\\\"@\\n\\n# Function to query Ollama\\nfunction Invoke-OllamaJudge {\\n    param([string]$chunk)\\n    $payload = @{\\n        model  = $modelName\\n        prompt = $judgePrompt + \\\"`n\\\" + $chunk\\n        stream = $false\\n    } | ConvertTo-Json -Depth 3\\n\\n    try {\\n        $response = Invoke-RestMethod -Uri $ollamaEndpoint -Method Post -Body $payload -ContentType \\\"application/json\\\" -UseBasicParsing -TimeoutSec 120\\n        $text = $response.response.Trim()\\n        return $text\\n    } catch {\\n        Write-Log \\\"ERROR querying Ollama: $_\\\"\\n        return \\\"ERROR\\\"\\n    }\\n}\\n\\n# Main processing\\nif (Test-Path $inputFile) {\\n    $content = Get-Content -Path $inputFile -Raw\\n    # Split into chunks (double newline)\\n    $chunks = $content -split \\\"`n`n\\\"\\n    foreach ($chunk in $chunks) {\\n        if ([string]::IsNullOrWhiteSpace($chunk)) { continue }\\n        $result = Invoke-OllamaJudge -chunk $chunk.Trim()\\n        if ($result -like \\\"ACCEPT:*\\\") {\\n            $summary = $result.Substring(\\\"ACCEPT:\\\".length).Trim()\\n            # Append to research_brief.md with a timestamp\\n            $timestamp = Get-Date -Format \\\"yyyy-MM-dd HH:mm\\\"\\n            $line = \\\"[$timestamp] $summary\\\"\\n            Add-Content -Path $outputFile -Value $line\\n            Write-Log \\\"ACCEPTED: $summary\\\"\\n        } elseif ($result -eq \\\"REJECT\\\") {\\n            Write-Log \\\"REJECTED chunk\\\"\\n        } else {\\n            Write-Log \\\"UNEXPECTED RESPONSE: $result\\\"\\n        }\\n    }\\n} else {\\n    Write-Log \\\"Input file not found: $inputFile. No processing performed.\\\"\\n}\",\"path\":\"C:\\\\Users\\\\MikeT\\\\Projects\\\\WASP_Core_Update_Project\\\\research_ollama.ps1\"}"}],"api":"openai-completions","provider":"nvidia","model":"nvidia/nemotron-3-super-120b-a12b","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784144812918,"responseId":"chatcmpl-de36ab73-b584-4209-b2ec-899c1db16275"}}
