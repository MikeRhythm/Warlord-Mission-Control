{"type":"message","id":"9779944a","parentId":"d34272fa","timestamp":"2026-07-15T13:58:45.689Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call-a7710775-c7aa-42ba-a617-36a2f4e25535","name":"write","arguments":{"action":"write","path":"C:\\Users\\MikeT\\Projects\\Chief Madithi\\research_ollama.ps1","content":"# research_ollama.ps1\n# 6-Pillar Intelligence Net filter using local Ollama (qwen2.5)\n\n# Configuration\n$ollamaEndpoint = \"http://localhost:11434/api/generate\"\n$modelName = \"qwen2.5\"\n$inputFile = \"C:\\Users\\MikeT\\Projects\\Chief Madithi\\raw_feed.txt\"   # optional input source\n$outputFile = \"C:\\Users\\MikeT\\Projects\\Chief Madithi\\research_brief.md\"\n$logFile = \"C:\\Users\\MikeT\\Projects\\Chief Madithi\\research_ollama.log\"\n\nfunction Write-Log {\n    param([string]$message)\n    $timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\n    \"$timestamp $message\" | Out-File -FilePath $logFile -Append -Encoding utf8\n}\n\n# Ensure output file exists\nif (-not (Test-Path $outputFile)) {\n    New-Item -ItemType File -Path $outputFile -Force | Out-Null\n}\n\n# Define the judge prompt template\n$judgePrompt = @\"\nYou are the WASP System Judge, an expert analyst tasked with filtering raw intelligence for the 6-Pillar Intelligence Net.\nYour sole purpose is to extract ONLY actionable, high-leverage nuggets that directly improve one or more of the following areas:\n1. Local Base 1 optimization or UI improvements (performance, automation, dashboard enhancements).\n2. Automated SEO, lead generation, and distribution (programmatic SEO, traffic acquisition, outreach automation).\n3. Specific range trading strategies or smart money concepts (15‑minute range, order blocks, liquidity sweeps, institutional footprints).\n4. Modern online business models and high‑leverage monetization loops (AI monetization, builder‑distributor, micro‑communities, profit‑share systems).\nIgnore general tech news, gossip, or any content that does not contain a concrete, implementable insight tied to the above pillars.\nFor each input chunk, respond with exactly one line:\n- If the chunk contains a qualifying nugget, output: ACCEPT: <concise 2‑3 sentence technical summary of the actionable insight>\n- Otherwise, output: REJECT\nDo not add any extra explanation or formatting.\n\"@\n\n# Function to query Ollama\nfunction Invoke-OllamaJudge {\n    param([string]$chunk)\n    $payload = @{\n        model  = $modelName\n        prompt = $judgePrompt + \"`n\" + $chunk\n        stream = $false\n    } | ConvertTo-Json -Depth 3\n\n    try {\n        $response = Invoke-RestMethod -Uri $ollamaEndpoint -Method Post -Body $payload -ContentType \"application/json\" -UseBasicParsing -TimeoutSec 30\n        $text = $response.response.Trim()\n        return $text\n    } catch {\n        Write-Log \"ERROR querying Ollama: $_\"\n        return \"ERROR\"\n    }\n}\n\n# Main processing\nif (Test-Path $inputFile) {\n    $content = Get-Content -Path $inputFile -Raw\n    # Split into chunks (e.g., double newline or every 500 chars). Here we use double newline as a simple chunk delimiter.\n    $chunks = $content -split \"`n`n\"\n    foreach ($chunk in $chunks) {\n        if ([string]::IsNullOrWhiteSpace($chunk)) { continue }\n        $result = Invoke-OllamaJudge -chunk $chunk.Trim()\n        if ($result -like \"ACCEPT:*\") {\n            $summary = $result.Substring(\"ACCEPT:\".length).Trim()\n            # Append to research_brief.md with a timestamp\n            $timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm\"\n            $line = \"[$timestamp] $summary\"\n            Add-Content -Path $outputFile -Value $line\n            Write-Log \"ACCEPTED: $summary\"\n        } elseif ($result -eq \"REJECT\") {\n            Write-Log \"REJECTED chunk\"\n        } else {\n            Write-Log \"UNEXPECTED RESPONSE: $result\"\n        }\n    }\n} else {\n    Write-Log \"Input file not found: $inputFile. No processing performed.\"\n}"},"partialArgs":"{\"action\":\"write\",\"path\":\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\research_ollama.ps1\",\"content\":\"# research_ollama.ps1\\n# 6-Pillar Intelligence Net filter using local Ollama (qwen2.5)\\n\\n# Configuration\\n$ollamaEndpoint = \\\"http://localhost:11434/api/generate\\\"\\n$modelName = \\\"qwen2.5\\\"\\n$inputFile = \\\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\raw_feed.txt\\\"   # optional input source\\n$outputFile = \\\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\research_brief.md\\\"\\n$logFile = \\\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\research_ollama.log\\\"\\n\\nfunction Write-Log {\\n    param([string]$message)\\n    $timestamp = Get-Date -Format \\\"yyyy-MM-dd HH:mm:ss\\\"\\n    \\\"$timestamp $message\\\" | Out-File -FilePath $logFile -Append -Encoding utf8\\n}\\n\\n# Ensure output file exists\\nif (-not (Test-Path $outputFile)) {\\n    New-Item -ItemType File -Path $outputFile -Force | Out-Null\\n}\\n\\n# Define the judge prompt template\\n$judgePrompt = @\\\"\\nYou are the WASP System Judge, an expert analyst tasked with filtering raw intelligence for the 6-Pillar Intelligence Net.\\nYour sole purpose is to extract ONLY actionable, high-leverage nuggets that directly improve one or more of the following areas:\\n1. Local Base 1 optimization or UI improvements (performance, automation, dashboard enhancements).\\n2. Automated SEO, lead generation, and distribution (programmatic SEO, traffic acquisition, outreach automation).\\n3. Specific range trading strategies or smart money concepts (15‑minute range, order blocks, liquidity sweeps, institutional footprints).\\n4. Modern online business models and high‑leverage monetization loops (AI monetization, builder‑distributor, micro‑communities, profit‑share systems).\\nIgnore general tech news, gossip, or any content that does not contain a concrete, implementable insight tied to the above pillars.\\nFor each input chunk, respond with exactly one line:\\n- If the chunk contains a qualifying nugget, output: ACCEPT: <concise 2‑3 sentence technical summary of the actionable insight>\\n- Otherwise, output: REJECT\\nDo not add any extra explanation or formatting.\\n\\\"@\\n\\n# Function to query Ollama\\nfunction Invoke-OllamaJudge {\\n    param([string]$chunk)\\n    $payload = @{\\n        model  = $modelName\\n        prompt = $judgePrompt + \\\"`n\\\" + $chunk\\n        stream = $false\\n    } | ConvertTo-Json -Depth 3\\n\\n    try {\\n        $response = Invoke-RestMethod -Uri $ollamaEndpoint -Method Post -Body $payload -ContentType \\\"application/json\\\" -UseBasicParsing -TimeoutSec 30\\n        $text = $response.response.Trim()\\n        return $text\\n    } catch {\\n        Write-Log \\\"ERROR querying Ollama: $_\\\"\\n        return \\\"ERROR\\\"\\n    }\\n}\\n\\n# Main processing\\nif (Test-Path $inputFile) {\\n    $content = Get-Content -Path $inputFile -Raw\\n    # Split into chunks (e.g., double newline or every 500 chars). Here we use double newline as a simple chunk delimiter.\\n    $chunks = $content -split \\\"`n`n\\\"\\n    foreach ($chunk in $chunks) {\\n        if ([string]::IsNullOrWhiteSpace($chunk)) { continue }\\n        $result = Invoke-OllamaJudge -chunk $chunk.Trim()\\n        if ($result -like \\\"ACCEPT:*\\\") {\\n            $summary = $result.Substring(\\\"ACCEPT:\\\".length).Trim()\\n            # Append to research_brief.md with a timestamp\\n            $timestamp = Get-Date -Format \\\"yyyy-MM-dd HH:mm\\\"\\n            $line = \\\"[$timestamp] $summary\\\"\\n            Add-Content -Path $outputFile -Value $line\\n            Write-Log \\\"ACCEPTED: $summary\\\"\\n        } elseif ($result -eq \\\"REJECT\\\") {\\n            Write-Log \\\"REJECTED chunk\\\"\\n        } else {\\n            Write-Log \\\"UNEXPECTED RESPONSE: $result\\\"\\n        }\\n    }\\n} else {\\n    Write-Log \\\"Input file not found: $inputFile. No processing performed.\\\"\\n}\"}"}],"api":"openai-completions","provider":"nvidia","model":"nvidia/nemotron-3-super-120b-a12b","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784123891950,"responseId":"chatcmpl-bf44c075-b186-4e01-bbd1-4598b0bfdeb9"}}
