{"type":"message","id":"064f6929","parentId":"711a28fc","timestamp":"2026-07-15T12:26:23.861Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call-332c8d11-f5e0-427f-8bfb-9ab0ee041b21","name":"write","arguments":{"content":"# base1_status.ps1\n# Health check script for Base 1\n# Checks required directories, ports, and Ollama/qwen2.5 service.\n\nfunction Test-PortOpen($port) {\n    try {\n        $tcpClient = New-Object System.Net.Sockets.TcpClient\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\n        if (-not $success) { return $false }\n        $tcpClient.EndConnect($result) | Out-Null\n        $tcpClient.Close()\n        return $true\n    } catch { return $false }\n}\n\nfunction Test-Ollama {\n    try {\n        $response = Invoke-RestMethod -Uri 'http://localhost:11434/api/tags' -TimeoutSec 2 -ErrorAction Stop\n        return $true\n    } catch { return $false }\n}\n\nfunction Get-LatestMetaTraderFolder($platform) {\n    $metaquotePath = Join-Path $env:APPDATA \"MetaQuotes\\Terminal\"\n    if (-not (Test-Path $metaquotePath)) { return $null }\n    $folders = Get-ChildItem -Path $metaquotePath -Directory | Sort-Object LastWriteTime -Descending\n    if ($folders) {\n        $latest = $folders[0].FullName\n        return Join-Path $latest $platform\n    }\n    return $null\n}\n\n# Define required paths\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\n$requiredPaths = @(Join-Path $scriptDir '.env')\n$missionControlPath = 'C:\\Warlord_Inc\\Warlord_WASP\\.openclaw\\.openclaw\\workspace\\mission-control-app'\n$mql4ExpertsPath = Get-LatestMetaTraderFolder 'MQL4\\Experts'\n$mql5IndicatorsPath = Get-LatestMetaTraderFolder 'MQL5\\Indicators'\n\n# Build the list of paths to check\n$pathsToCheck = @(\n    @{ Name = '.env (Project)'; Path = (Join-Path $scriptDir '.env') }\n    @{ Name = 'Mission Control App'; Path = $missionControlPath }\n    @{ Name = 'MQL4 Experts'; Path = $mql4ExpertsPath }\n    @{ Name = 'MQL5 Indicators'; Path = $mql5IndicatorsPath }\n)\n\nWrite-Host \"=== Base 1 Health Check ===\" -ForegroundColor Cyan\n\n# Check directories/files\nforeach ($item in $pathsToCheck) {\n    $path = $item.Path\n    $name = $item.Name\n    if ($path -and (Test-Path -Path $path)) {\n        Write-Host \"[OK]  $name\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] $name\" -ForegroundColor Red\n    }\n}\n\n# Check ports\n$portsToCheck = @(18789) # OpenClaw UI; add others if known\nforeach ($port in $portsToCheck) {\n    if (Test-PortOpen -port $port) {\n        Write-Host \"[OK]  Port $port listening\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] Port $port not listening\" -ForegroundColor Red\n    }\n}\n\n# Check Ollama/qwen2.5\nif (Test-Ollama) {\n    Write-Host \"[OK]  Ollama/qwen2.5 service responding\" -ForegroundColor Green\n} else {\n    Write-Host \"[FAIL] Ollama/qwen2.5 not responding\" -ForegroundColor Red\n}\n\nWrite-Host \"===========================\" -ForegroundColor Cyan","path":"C:\\Users\\MikeT\\Projects\\Chief Madithi\\base1_status.ps1"},"partialArgs":"{\"content\":\"# base1_status.ps1\\n# Health check script for Base 1\\n# Checks required directories, ports, and Ollama/qwen2.5 service.\\n\\nfunction Test-PortOpen($port) {\\n    try {\\n        $tcpClient = New-Object System.Net.Sockets.TcpClient\\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\\n        if (-not $success) { return $false }\\n        $tcpClient.EndConnect($result) | Out-Null\\n        $tcpClient.Close()\\n        return $true\\n    } catch { return $false }\\n}\\n\\nfunction Test-Ollama {\\n    try {\\n        $response = Invoke-RestMethod -Uri 'http://localhost:11434/api/tags' -TimeoutSec 2 -ErrorAction Stop\\n        return $true\\n    } catch { return $false }\\n}\\n\\nfunction Get-LatestMetaTraderFolder($platform) {\\n    $metaquotePath = Join-Path $env:APPDATA \\\"MetaQuotes\\\\Terminal\\\"\\n    if (-not (Test-Path $metaquotePath)) { return $null }\\n    $folders = Get-ChildItem -Path $metaquotePath -Directory | Sort-Object LastWriteTime -Descending\\n    if ($folders) {\\n        $latest = $folders[0].FullName\\n        return Join-Path $latest $platform\\n    }\\n    return $null\\n}\\n\\n# Define required paths\\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\\n$requiredPaths = @(Join-Path $scriptDir '.env')\\n$missionControlPath = 'C:\\\\Warlord_Inc\\\\Warlord_WASP\\\\.openclaw\\\\.openclaw\\\\workspace\\\\mission-control-app'\\n$mql4ExpertsPath = Get-LatestMetaTraderFolder 'MQL4\\\\Experts'\\n$mql5IndicatorsPath = Get-LatestMetaTraderFolder 'MQL5\\\\Indicators'\\n\\n# Build the list of paths to check\\n$pathsToCheck = @(\\n    @{ Name = '.env (Project)'; Path = (Join-Path $scriptDir '.env') }\\n    @{ Name = 'Mission Control App'; Path = $missionControlPath }\\n    @{ Name = 'MQL4 Experts'; Path = $mql4ExpertsPath }\\n    @{ Name = 'MQL5 Indicators'; Path = $mql5IndicatorsPath }\\n)\\n\\nWrite-Host \\\"=== Base 1 Health Check ===\\\" -ForegroundColor Cyan\\n\\n# Check directories/files\\nforeach ($item in $pathsToCheck) {\\n    $path = $item.Path\\n    $name = $item.Name\\n    if ($path -and (Test-Path -Path $path)) {\\n        Write-Host \\\"[OK]  $name\\\" -ForegroundColor Green\\n    } else {\\n        Write-Host \\\"[FAIL] $name\\\" -ForegroundColor Red\\n    }\\n}\\n\\n# Check ports\\n$portsToCheck = @(18789) # OpenClaw UI; add others if known\\nforeach ($port in $portsToCheck) {\\n    if (Test-PortOpen -port $port) {\\n        Write-Host \\\"[OK]  Port $port listening\\\" -ForegroundColor Green\\n    } else {\\n        Write-Host \\\"[FAIL] Port $port not listening\\\" -ForegroundColor Red\\n    }\\n}\\n\\n# Check Ollama/qwen2.5\\nif (Test-Ollama) {\\n    Write-Host \\\"[OK]  Ollama/qwen2.5 service responding\\\" -ForegroundColor Green\\n} else {\\n    Write-Host \\\"[FAIL] Ollama/qwen2.5 not responding\\\" -ForegroundColor Red\\n}\\n\\nWrite-Host \\\"===========================\\\" -ForegroundColor Cyan\",\"path\":\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\base1_status.ps1\"}"}],"api":"openai-completions","provider":"nvidia","model":"nvidia/nemotron-3-super-120b-a12b","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784118359901,"responseId":"chatcmpl-7d726da0-4e62-4bed-965e-30cfdb0d9b9b"}}
