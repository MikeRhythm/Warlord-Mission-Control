  return $sub.FullName\n                    }\n                }\n                # If no subfolder with MQL5, maybe the base itself has MQL5?\n                if (Test-Path -Path (Join-Path -Path $base -ChildPath 'MQL5')) {\n                    return $base\n                }\n            } catch {\n                # If we cannot enumerate, just assume this base is valid if it exists\n                return $base\n            }\n        }\n    }\n    \n    # Check AppData MetaQuotes\n    $appData = [Environment]::GetFolderPath('ApplicationData')\n    $metaquotePath = Join-Path -Path $appData -ChildPath 'MetaQuotes\\Terminal'\n    if (Test-Path -Path $metaquotePath) {\n        try {\n            $instances = Get-ChildItem -Path $metaquotePath -Directory -ErrorAction Stop | Sort-Object LastWriteTime -Descending\n            if ($instances) {\n                $latest = $instances[0].FullName\n                if (Test-Path -Path (Join-Path -Path $latest -ChildPath 'MQL5')) {\n                    return $latest\n                }\n            }\n        } catch {}\n    }\n    \n    return $null\n}\n\n# Define required paths\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\n$envPath = Join-Path $scriptDir '.env'\n$missionControlPath = 'C:\\Warlord_Inc\\Warlord_WASP\\.openclaw\\.openclaw\\workspace\\mission-control-app'\n\n# MetaTrader paths\n$mtBase = Find-MetaTraderBasePath\nif ($mtBase) {\n    $mql4ExpertsPath = Join-Path -Path $mtBase -ChildPath 'MQL4\\Experts'\n    $mql5IndicatorsPath = Join-Path -Path $mtBase -ChildPath 'MQL5\\Indicators'\n} else {\n    # Fallback to relative paths from script location (as originally intended)\n    $mql4ExpertsPath = Join-Path -Path $scriptDir -ChildPath '..\\..\\..\\MQL4\\Experts'\n    $mql5IndicatorsPath = Join-Path -Path $scriptDir -ChildPath '..\\..\\..\\MQL5\\Indicators'\n}\n\n# Build the list of paths to check\n$pathsToCheck = @(\n    @{ Name = '.env (Project)'; Path = $envPath }\n    @{ Name = 'Mission Control App'; Path = $missionControlPath }\n    @{ Name = 'MQL4 Experts'; Path = $mql4ExpertsPath }\n    @{ Name = 'MQL5 Indicators'; Path = $mql5IndicatorsPath }\n)\n\nWrite-Host \"=== Base 1 Health Check ===\" -ForegroundColor Cyan\n\n# Check directories/files\nforeach ($item in $pathsToCheck) {\n    $path = $item.Path\n    $name = $item.Name\n    if ($path -and (Test-Path -Path $path)) {\n        Write-Host \"[OK]  $name\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] $name\" -ForegroundColor Red\n    }\n}\n\n# Check ports\n$portsToCheck = @(18789) # OpenClaw UI; add others if known\nforeach ($port in $portsToCheck) {\n    if (Test-PortOpen -port $port) {\n        Write-Host \"[OK]  Port $port listening\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] Port $port not listening\" -ForegroundColor Red\n    }\n}\n\n# Check Ollama/qwen2.5\nif (Test-Ollama) {\n    Write-Host \"[OK]  Ollama/qwen2.5 service responding\" -ForegroundColor Green\n} else {\n    Write-Host \"[FAIL] Ollama/qwen2.5 not responding\" -ForegroundColor Red\n    Write-Host \"  Hint: Start Ollama service by running 'ollama serve' in a separate terminal.\" -ForegroundColor Yellow\n}\n\nWrite-Host \"===========================\" -ForegroundColor Cyan","path":"C:\\Users\\MikeT\\Projects\\Chief Madithi\\base1_status.ps1"},"partialArgs":"{\"content\":\"# base1_status.ps1\\n# Health check script for Base 1\\n# Checks required directories, ports, and Ollama/qwen2.5 service.\\n\\nfunction Test-PortOpen($port) {\\n    try {\\n        $tcpClient = New-Object System.Net.Sockets.TcpClient\\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\\n        if (-not $success) { return $false }\\n        $tcpClient.EndConnect($result) | Out-Null\\n        $tcpClient.Close()\\n        return $true\\n    } catch { return $false }\\n}\\n\\nfunction Test-Ollama {\\n    try {\\n        $response = Invoke-RestMethod -Uri 'http://localhost:11434/api/tags' -TimeoutSec 2 -ErrorAction Stop\\n        return $true\\n    } catch { return $false }\\n}\\n\\nfunction Find-MetaTraderBasePath {\\n    # Get ProgramFiles paths\\n    $programFiles = [Environment]::GetFolderPath('ProgramFiles')\\n    $programFilesx86 = [Environment]::GetFolderPath('ProgramFilesX86')\\n    \\n    # Common base paths for MetaTrader installations\\n    $basePaths = @(\\n        Join-Path -Path $programFiles -ChildPath 'MetaTrader 5',\\n        Join-Path -Path $programFilesx86 -ChildPath 'MetaTrader 5',\\n        Join-Path -Path $programFiles -ChildPath 'MetaTrader 4',\\n        Join-Path -Path $programFilesx86 -ChildPath 'MetaTrader 4'\\n    )\\n    \\n    foreach ($base in $basePaths) {\\n        if (Test-Path -Path $base) {\\n            # Look for any subdirectory that contains MQL5 (indicating a terminal instance)\\n            try {\\n                $subdirs = Get-ChildItem -Path $base -Directory -ErrorAction Stop\\n                foreach ($sub in $subdirs) {\\n                    if (Test-Path -Path (Join-Path -Path $sub.FullName -ChildPath 'MQL5')) {\\n                        return $sub.FullName\\n                    }\\n                }\\n                # If no subfolder with MQL5, maybe the base itself has MQL5?\\n                if (Test-Path -Path (Join-Path -Path $base -ChildPath 'MQL5')) {\\n                    return $base\\n                }\\n            } catch {\\n                # If we cannot enumerate, just assume this base is valid if it exists\\n                return $base\\n            }\\n        }\\n    }\\n    \\n    # Check AppData MetaQuotes\\n    $appData = [Environment]::GetFolderPath('ApplicationData')\\n    $metaquotePath = Join-Path -Path $appData -ChildPath 'MetaQuotes\\\\Terminal'\\n    if (Test-Path -Path $metaquotePath) {\\n        try {\\n            $instances = Get-ChildItem -Path $metaquotePath -Directory -ErrorAction Stop | Sort-Object LastWriteTime