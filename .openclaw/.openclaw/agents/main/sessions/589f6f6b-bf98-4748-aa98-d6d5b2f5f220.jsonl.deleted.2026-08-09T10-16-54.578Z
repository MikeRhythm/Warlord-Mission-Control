{"type":"message","id":"2649a3ce","parentId":"b8e7c049","timestamp":"2026-07-15T12:09:10.883Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call-4eca5f60-2a9d-4bf6-99f9-15b34ae0f0e9","name":"write","arguments":{"path":"C:\\Users\\MikeT\\Projects\\Chief Madithi\\base1_status.ps1","content":"# base1_status.ps1\n# Health check script for Base 1\n# Checks required directories, ports, and Ollama/qwen2.5 service.\n\nfunction Test-PortOpen($port) {\n    try {\n        $tcpClient = New-Object System.Net.Sockets.TcpClient\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\n        if (-not $success) { return $false }\n        $false }\n        $tcpClient.EndConnect($result) | Out-Null\n        $tcpClient.Close()\n        return $true\n    } catch { return $false }\n}\n\nfunction Test-Ollama {\n    try {\n        $response = Invoke-RestMethod -Uri 'http://localhost:11434/api/tags' -TimeoutSec 2 -ErrorAction Stop\n        return $true\n    } catch { return $false }\n}\n\n# Define required paths (relative to script location)\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\n$requiredPaths = @(\n    Join-Path $scriptDir '..\\..\\..\\MQL4\\Experts',\n    Join-Path $scriptDir '..\\..\\..\\MQL5\\Indicators',\n    Join-Path $scriptDir '..\\mission-control-app',\n    Join-Path $scriptDir '.env'\n)\n\nWrite-Host \"=== Base 1 Health Check ===\" -ForegroundColor Cyan\n\n# Check directories/files\nforeach ($path in $requiredPaths) {\n    if (Test-Path -Path $path) {\n        Write-Host \"[OK]  $path\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] $path\" -ForegroundColor Red\n    }\n}\n\n# Check ports\n$portsToCheck = @(18789) # OpenClaw UI; add others if known\nforeach ($port in $portsToCheck) {\n    if (Test-PortOpen -port $port) {\n        Write-Host \"[OK]  Port $port listening\" -ForegroundColor Green\n    } else {\n        Write-Host \"[FAIL] Port $port not listening\" -ForegroundColor Red\n    }\n}\n\n# Check Ollama/qwen2.5\nif (Test-Ollama) {\n    Write-Host \"[OK]  Ollama/qwen2.5 service responding\" -ForegroundColor Green\n} else {\n    Write-Host \"[FAIL] Ollama/qwen2.5 not responding\" -ForegroundColor Red\n}\n\nWrite-Host \"===========================\" -ForegroundColor Cyan"},"partialArgs":"{\"path\":\"C:\\\\Users\\\\MikeT\\\\Projects\\\\Chief Madithi\\\\base1_status.ps1\",\"content\":\"# base1_status.ps1\\n# Health check script for Base 1\\n# Checks required directories, ports, and Ollama/qwen2.5 service.\\n\\nfunction Test-PortOpen($port) {\\n    try {\\n        $tcpClient = New-Object System.Net.Sockets.TcpClient\\n        $result = $tcpClient.BeginConnect('127.0.0.1', $port, $null, $null)\\n        $success = $result.AsyncWaitHandle.WaitOne(1000, $false)\\n        if (-not $success) { return $false }\\n        $false }\\n        $tcpClient.EndConnect($result) | Out-Null\\n        $tcpClient.Close()\\n        return $true\\n    } catch { return $false }\\n}\\n\\nfunction Test-Ollama {\\n    try {\\n        $response = Invoke-RestMethod -Uri 'http://localhost:11434/api/tags' -TimeoutSec 2 -ErrorAction Stop\\n        return $true\\n    } catch { return $false }\\n}\\n\\n# Define required paths (relative to script location)\\n$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition\\n$requiredPaths = @(\\n    Join-Path $scriptDir '..\\\\..\\\\..\\\\MQL4\\\\Experts',\\n    Join-Path $scriptDir '..\\\\..\\\\..\\\\MQL5\\\\Indicators',\\n    Join-Path $scriptDir '..\\\\mission-control-app',\\n    Join-Path $scriptDir '.env'\\n)\\n\\nWrite-Host \\\"=== Base 1 Health Check ===\\\" -ForegroundColor Cyan\\n\\n# Check directories/files\\nforeach ($path in $requiredPaths) {\\n    if (Test-Path -Path $path) {\\n        Write-Host \\\"[OK]  $path\\\" -ForegroundColor Green\\n    } else {\\n        Write-Host \\\"[FAIL] $path\\\" -ForegroundColor Red\\n    }\\n}\\n\\n# Check ports\\n$portsToCheck = @(18789) # OpenClaw UI; add others if known\\nforeach ($port in $portsToCheck) {\\n    if (Test-PortOpen -port $port) {\\n        Write-Host \\\"[OK]  Port $port listening\\\" -ForegroundColor Green\\n    } else {\\n        Write-Host \\\"[FAIL] Port $port not listening\\\" -ForegroundColor Red\\n    }\\n}\\n\\n# Check Ollama/qwen2.5\\nif (Test-Ollama) {\\n    Write-Host \\\"[OK]  Ollama/qwen2.5 service responding\\\" -ForegroundColor Green\\n} else {\\n    Write-Host \\\"[FAIL] Ollama/qwen2.5 not responding\\\" -ForegroundColor Red\\n}\\n\\nWrite-Host \\\"===========================\\\" -ForegroundColor Cyan\"}"}],"api":"openai-completions","provider":"nvidia","model":"nvidia/nemotron-3-super-120b-a12b","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1784117331820,"responseId":"chatcmpl-15997d12-d9f4-4b7f-a102-4972a0534002"}}
