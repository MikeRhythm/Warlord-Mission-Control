    const handleSignOff = (id, action) => {
        if (action === 'REVISE') {
            const target = deliverables.find(d => d.id === id);
            if (target) handleReviseTicket(target);
            return;
        }

        const updatedDeliverables = deliverables.map(item => {
            if (item.id === id) {
                return {
                    ...item,
                    status: 'APPROVED // SEALED'
