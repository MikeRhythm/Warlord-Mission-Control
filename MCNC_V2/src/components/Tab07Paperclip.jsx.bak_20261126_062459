                persistedFile,
                montyJudgeVerdict: judgeReport,
                paperclipStatus: newStatus,
                stage: isPassed ? 'HUMAN GATE' : 'AGENT BUILD'
            });

        } catch (err) {
            console.error('Execution loop failed', err);
        } finally {
            setIsExecutingLoop(false);
            setLoopStatusText('');
        }
    };

