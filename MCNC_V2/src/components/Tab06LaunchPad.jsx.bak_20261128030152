                  }}
                />
              </div>

              <div>
                <label style={{ fontSize: '0.66rem', color: '#94a3b8', display: 'block', marginBottom: '3px' }}>Price ($)</label>
                <input
                  type="number"
                  min="0"
                  value={cfg.price}
                  onChange={(e) => setVal('price', Number(e.target.value))}
                  style={{
                    width: '100%',
                    padding: '7px 9px',
                    backgroundColor: '#101318',
                    border: '1px solid #232a36',
                    borderRadius: '3px',
                    color: '#10b981',
                    fontWeight: 'bold',
                    fontSize: '0.73rem',
