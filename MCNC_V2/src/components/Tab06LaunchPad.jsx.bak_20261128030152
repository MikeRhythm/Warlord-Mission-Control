                >
                  <div style={{ minWidth: 0 }}>
                    <div style={{ fontSize: '0.75rem', fontWeight: 'bold', color: '#f8fafc', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                      {offer.name}
                    </div>
                    <div style={{ fontSize: '0.66rem', color: '#8fa0b5', marginTop: '2px' }}>
                      <span style={{ color: '#10b981', fontWeight: 'bold' }}>${offer.price}</span> ({offer.billing}) • {offer.rail} • {offer.mode === 'MEMBERS_ONLY' ? 'Members Only' : 'Open'}
                    </div>
                  </div>

                  <div style={{ display: 'flex', alignItems: 'center', gap: '6px', flexShrink: 0 }}>
                    <button
                      type="button"
                      onClick={() => copyPayload(`${offer.name} — $${offer.price} (${offer.billing}) — ${offer.url}`, offer.id)}
                      style={{
                        padding: '4px 8px',
                        backgroundColor: '#161c26',
                        border: '1px solid #2a3446',
                        borderRadius: '2px',
                        color: '#DAA520',
                        fontSize: '0.66rem',
                        fontWeight: 'bold',
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '4px'
                      }}
                    >
                      {copiedKey === offer.id ? <Check style={{ width: '11px', height: '11px' }} /> : <Copy style={{ width: '11px', height: '11px' }} />}
                      <span>{copiedKey === offer.id ? 'COPIED' : 'COPY'}</span>
                    </button>
                    <button
                      type="button"
                      onClick={() => handleRemoveOffer(offer.id)}
                      style={{
                        padding: '4px 6px',
                        backgroundColor: 'transparent',
                        border: '1px solid #262e3d',
                        borderRadius: '2px',
                        color: '#94a3b8',
                        cursor: 'pointer'
                      }}
                      title="Remove offer"
                    >
                      <Trash2 style={{ width: '12px', height: '12px' }} />
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </main>

        {/* RIGHT: UNIT ECONOMICS & BREAK-EVEN */}
        <aside
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: '10px',
            backgroundColor: '#0d1015',
            border: '1px solid #1f242d',
            borderRadius: '3px',
            padding: '12px',
            overflowY: 'auto'
          }}
          className="custom-scrollbar"
        >
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', borderBottom: '1px solid #1b212c', paddingBottom: '8px' }}>
            <span style={{ fontSize: '0.75rem', fontWeight: 'bold', color: '#10b981', display: 'flex', alignItems: 'center', gap: '6px' }}>
              <Calculator style={{ width: '14px', height: '14px' }} />
              UNIT ECONOMICS
            </span>
            <span style={{ fontSize: '0.65rem', color: '#8fa0b5' }}>LIVE</span>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
            <div>
              <label style={{ fontSize: '0.66rem', color: '#94a3b8', display: 'block', marginBottom: '3px' }}>Fee (%)</label>
              <input
                type="number"
                min="0"
                max="30"
                step="0.1"
                value={cfg.feePct}
                onChange={(e) => setVal('feePct', Number(e.target.value))}
                style={{
                  width: '100%',
                  padding: '6px 8px',
                  backgroundColor: '#101318',
                  border: '1px solid #232a36',
                  borderRadius: '3px',
                  color: '#e2e8f0',
                  fontSize: '0.72rem',
                  boxSizing: 'border-box',
                  outline: 'none'
                }}
              />
            </div>

            <div>
              <label style={{ fontSize: '0.66rem', color: '#94a3b8', display: 'block', marginBottom: '3px' }}>Monthly Cost ($)</label>
              <input
                type="number"
                min="0"
                value={cfg.monthlyStackCost}
                onChange={(e) => setVal('monthlyStackCost', Number(e.target.value))}
                style={{
                  width: '100%',
                  padding: '6px 8px',
                  backgroundColor: '#101318',
                  border: '1px solid #232a36',
                  borderRadius: '3px',
                  color: '#e2e8f0',
                  fontSize: '0.72rem',
                  boxSizing: 'border-box',
                  outline: 'none'
                }}
              />
            </div>
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginTop: '4px' }}>
            <div style={{ padding: '10px', backgroundColor: '#10141c', border: '1px solid #1e2634', borderRadius: '3px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.68rem', color: '#94a3b8' }}>NET PER SALE</span>
              <span style={{ fontSize: '0.88rem', fontWeight: 'bold', color: '#10b981' }}>${netPerSale.toFixed(2)}</span>
            </div>

            <div style={{ padding: '10px', backgroundColor: '#10141c', border: '1px solid #1e2634', borderRadius: '3px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.68rem', color: '#94a3b8' }}>BREAK-EVEN</span>
              <span style={{ fontSize: '0.88rem', fontWeight: 'bold', color: '#DAA520' }}>
                {netPerSale > 0 ? `${breakEvenSales} sales` : 'Set price > fee'}
              </span>
            </div>

            <div style={{ padding: '10px', backgroundColor: '#10141c', border: '1px solid #1e2634', borderRadius: '3px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.68rem', color: '#94a3b8' }}>NET AT 25 SALES</span>
              <span style={{ fontSize: '0.88rem', fontWeight: 'bold', color: netAt25Sales >= 0 ? '#38bdf8' : '#f87171' }}>
                ${netAt25Sales.toFixed(2)}
              </span>
            </div>
          </div>
        </aside>

      </div>
    </div>
  );
}
