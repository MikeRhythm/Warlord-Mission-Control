            </div>
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: '4px' }}>
            <label style={{ fontSize: '0.66rem', color: '#94a3b8', textTransform: 'uppercase' }}>Tunnel / Edge Conduit</label>
            <input
              type="text"
