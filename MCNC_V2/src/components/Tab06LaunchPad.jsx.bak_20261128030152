import React, { useState, useEffect } from 'react';
import {
  Rocket, Globe, Lock, Unlock, CreditCard, CheckCircle2,
  Circle, Copy, Check, Plus, Trash2, ShieldCheck, Calculator, Send
} from 'lucide-react';
import SpeakerBtn from './SpeakerBtn';

const STORAGE_KEY = 'MCNC_06_LAUNCH_PAD_V1';

const DEFAULT_LAUNCHPAD = {
  liveUrl: 'https://rhythmtradingco.com',
  tunnelConduit: 'Cloudflare Tunnel + Tailscale Mesh',
  goLive: false,
  accessMode: 'MEMBERS_ONLY',
  primaryTier: 'rhythmtradingco AI — Member Access',
  price: 29,
  billing: 'MONTHLY',
  paymentRail: 'Stripe',
  checkoutUrl: 'https://rhythmtradingco.com/members',
  feePct: 2.9,
  monthlyStackCost: 15,
  gates: {
    dnsAndRouteReady: true,
    tlsAndAuthReady: true,
    checkoutLive: false,
    smokeTested: false
  },
  offers: [
    {
      id: 'offer-1',
      name: 'Single-Tier Member Access',
      price: 29,
      billing: 'MONTHLY',
      rail: 'Stripe',
      mode: 'MEMBERS_ONLY',
      url: 'https://rhythmtradingco.com/members'
    },
    {
      id: 'offer-2',
      name: 'Direct Support / Supporter Tier',
      price: 15,
      billing: 'ONE-TIME',
      rail: 'PayFast',
      mode: 'PUBLIC_CHECKOUT',
      url: 'https://rhythmtradingco.com/support'
    }
  ]
};

export default function Tab06LaunchPad({ ws }) {
  const [cfg, setCfg] = useState(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      return saved ? { ...DEFAULT_LAUNCHPAD, ...JSON.parse(saved) } : DEFAULT_LAUNCHPAD;
    } catch (e) {
      return DEFAULT_LAUNCHPAD;
    }
  });

  const [offerTitle, setOfferTitle] = useState('');
  const [offerPrice, setOfferPrice] = useState('49');
  const [offerBilling, setOfferBilling] = useState('MONTHLY');
  const [copiedKey, setCopiedKey] = useState(null);
  const [dispatchNotice, setDispatchNotice] = useState('');

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
    } catch (e) {}
  }, [cfg]);

  const setVal = (key, value) => {
    setCfg((prev) => ({ ...prev, [key]: value }));
  };

  const toggleGate = (key) => {
    setCfg((prev) => ({
      ...prev,
      gates: { ...prev.gates, [key]: !prev.gates[key] }
    }));
  };

  const copyPayload = (text, key) => {
    navigator.clipboard.writeText(text);
    setCopiedKey(key);
    setTimeout(() => setCopiedKey(null), 1600);
  };

  const handleAddOffer = (e) => {
    e.preventDefault();
    const cleanName = offerTitle.trim();
    if (!cleanName) return;
    const nextOffer = {
      id: `lp-${Date.now()}`,
      name: cleanName,
      price: Math.max(0, Number(offerPrice) || 0),
      billing: offerBilling,
      rail: cfg.paymentRail,
      mode: cfg.accessMode,
      url: cfg.checkoutUrl.trim() || cfg.liveUrl.trim()
    };
    setCfg((prev) => ({ ...prev, offers: [nextOffer, ...prev.offers] }));
    setOfferTitle('');
  };

  const handleRemoveOffer = (id) => {
    setCfg((prev) => ({ ...prev, offers: prev.offers.filter((o) => o.id !== id) }));
  };

  const handleBroadcastLaunchState = () => {
    const payload = {
      type: 'LAUNCH_PAD_STATE',
      goLive: cfg.goLive,
      liveUrl: cfg.liveUrl,
      accessMode: cfg.accessMode,
      primaryTier: cfg.primaryTier,
      price: Number(cfg.price) || 0,
      billing: cfg.billing,
      paymentRail: cfg.paymentRail,
      checkoutUrl: cfg.checkoutUrl
    };
    window.dispatchEvent(new CustomEvent('mcnc-launchpad-updated', { detail: payload }));
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify(payload));
    }
    setDispatchNotice('SYNCED');
    setTimeout(() => setDispatchNotice(''), 1800);
  };

  const priceNum = Math.max(0, Number(cfg.price) || 0);
  const feeNum = Math.max(0, Number(cfg.feePct) || 0);
  const stackNum = Math.max(0, Number(cfg.monthlyStackCost) || 0);
  const netPerSale = priceNum - priceNum * (feeNum / 100);
  const breakEvenSales = netPerSale > 0 ? Math.ceil(stackNum / netPerSale) : 0;
  const netAt25Sales = netPerSale * 25 - stackNum;

  const gatesPassed = Object.values(cfg.gates).filter(Boolean).length;
  const gatesTotal = Object.keys(cfg.gates).length;

  const briefText = `06 LAUNCH-PAD status. Target URL ${cfg.liveUrl}. Go-live is ${cfg.goLive ? 'LIVE' : 'STANDBY'}. Mode is ${cfg.accessMode === 'MEMBERS_ONLY' ? 'members only' : 'open checkout'}. Offer is $${priceNum} ${cfg.billing} via ${cfg.paymentRail}. Net per sale $${netPerSale.toFixed(2)}, break-even ${breakEvenSales} conversions.`;

  return (
    <div
      style={{
        display: 'flex',
        flexDirection: 'column',
        height: '100%',
        width: '100%',
        padding: '14px',
        boxSizing: 'border-box',
        gap: '12px',
        backgroundColor: '#090b0e',
        color: '#e2e8f0',
        fontFamily: "'JetBrains Mono', monospace"
      }}
    >
      {/* HEADER BAR */}
      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          borderBottom: '1px solid #1f242d',
          paddingBottom: '10px',
          gap: '10px'
        }}
      >
        <div>
          <div style={{ color: '#DAA520', fontSize: '1rem', fontWeight: 'bold', letterSpacing: '1px' }}>
            06 LAUNCH-PAD // DEPLOYMENT, ACCESS GATES &amp; REVENUE ENGINE
          </div>
          <div style={{ fontSize: '0.7rem', color: '#8fa0b5', marginTop: '2px' }}>
            Ship live URLs, enforce member gating, wire payment rails, and track break-even economics
          </div>
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
          <SpeakerBtn text={briefText} label="READ BRIEF" />

          <button
            type="button"
            onClick={handleBroadcastLaunchState}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '5px',
              padding: '6px 10px',
              backgroundColor: '#121822',
              border: '1px solid #2b3545',
              color: '#38bdf8',
              borderRadius: '3px',
              fontSize: '0.7rem',
              fontWeight: 'bold',
              cursor: 'pointer'
            }}
          >
            <Send style={{ width: '12px', height: '12px' }} />
            <span>{dispatchNotice || 'SYNC STATE'}</span>
          </button>

          <button
            type="button"
            onClick={() => setVal('goLive', !cfg.goLive)}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '6px',
              padding: '6px 12px',
              backgroundColor: cfg.goLive ? 'rgba(16, 185, 129, 0.16)' : 'rgba(218, 165, 32, 0.14)',
              border: cfg.goLive ? '1px solid #10b981' : '1px solid #DAA520',
              color: cfg.goLive ? '#10b981' : '#DAA520',
              borderRadius: '3px',
              fontSize: '0.72rem',
              fontWeight: 'bold',
              cursor: 'pointer'
            }}
          >
            <Rocket style={{ width: '13px', height: '13px' }} />
            <span>{cfg.goLive ? 'LAUNCH: LIVE' : 'LAUNCH: STAGED'}</span>
          </button>

          <div
            style={{
              padding: '6px 10px',
              backgroundColor: '#101318',
              border: '1px solid #1f242d',
              borderRadius: '3px',
              fontSize: '0.7rem'
            }}
          >
            <span style={{ color: '#64748b' }}>GATES: </span>
            <span style={{ color: gatesPassed === gatesTotal ? '#10b981' : '#DAA520', fontWeight: 'bold' }}>
              {gatesPassed}/{gatesTotal}
            </span>
          </div>
        </div>
      </div>

      {/* 3-COLUMN LAUNCH-PAD WORKSPACE */}
      <div style={{ display: 'grid', gridTemplateColumns: '300px 1fr 300px', gap: '12px', flex: 1, minHeight: 0 }}>

        {/* LEFT: DOMAIN, TUNNEL & GO-LIVE GATES */}
        <aside
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: '10px',
            backgroundColor: '#0d1015',
            border: '1px solid #1f242d',
            borderRadius: '3px',
            padding: '12px',
            overflowY: 'auto'
          }}
          className="custom-scrollbar"
        >
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', borderBottom: '1px solid #1b212c', paddingBottom: '8px' }}>
            <span style={{ fontSize: '0.75rem', fontWeight: 'bold', color: '#DAA520', display: 'flex', alignItems: 'center', gap: '6px' }}>
              <Globe style={{ width: '14px', height: '14px' }} />
              LIVE TARGET &amp; CONDUIT
            </span>
            <span style={{ fontSize: '0.65rem', color: cfg.goLive ? '#10b981' : '#94a3b8' }}>
              {cfg.goLive ? 'LIVE' : 'STAGED'}
            </span>
