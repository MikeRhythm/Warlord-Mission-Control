          <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', marginTop: '4px' }}>
            <span style={{ fontSize: '0.66rem', color: '#94a3b8', textTransform: 'uppercase', fontWeight: 'bold' }}>
              RELEASE CHECKPOINTS
            </span>

            {[
              { key: 'dnsAndRouteReady', label: 'DNS & Tunnel Route Mapped' },
              { key: 'tlsAndAuthReady', label: 'HTTPS & Member Auth Wired' },
              { key: 'checkoutLive', label: 'Payment / Checkout Link Active' },
              { key: 'smokeTested', label: 'End-to-End Smoke Test Passed' }
            ].map((item) => {
              const active = Boolean(cfg.gates[item.key]);
              return (
                <button
                  key={item.key}
                  type="button"
                  onClick={() => toggleGate(item.key)}
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    gap: '8px',
                    padding: '8px 10px',
                    backgroundColor: '#101318',
                    border: active ? '1px solid rgba(16, 185, 129, 0.45)' : '1px solid #1d232e',
                    borderRadius: '3px',
                    color: active ? '#e2e8f0' : '#8fa0b5',
                    fontSize: '0.72rem',
                    textAlign: 'left',
                    cursor: 'pointer'
                  }}
                >
                  {active ? (
                    <CheckCircle2 style={{ width: '14px', height: '14px', color: '#10b981', flexShrink: 0 }} />
                  ) : (
                    <Circle style={{ width: '14px', height: '14px', color: '#64748b', flexShrink: 0 }} />
                  )}
                  <span>{item.label}</span>
                </button>
              );
            })}
          </div>

          <div
            style={{
              marginTop: 'auto',
              padding: '10px',
              backgroundColor: '#10151f',
              border: '1px solid #222b3a',
              borderRadius: '3px',
              display: 'flex',
              flexDirection: 'column',
              gap: '5px'
            }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.68rem', color: '#38bdf8', fontWeight: 'bold', display: 'flex', alignItems: 'center', gap: '4px' }}>
                <ShieldCheck style={{ width: '13px', height: '13px' }} />
                LAUNCH MANIFEST
              </span>
              <button
                type="button"
                onClick={() =>
                  copyPayload(
                    `URL: ${cfg.liveUrl}\nStatus: ${cfg.goLive ? 'LIVE' : 'STAGED'}\nGate: ${cfg.accessMode}\nOffer: ${cfg.primaryTier} ($${priceNum} ${cfg.billing})\nCheckout: ${cfg.checkoutUrl}`,
                    'manifest'
                  )
                }
                style={{
                  padding: '2px 7px',
                  backgroundColor: '#18202c',
                  border: '1px solid #2d384b',
                  borderRadius: '2px',
                  color: '#DAA520',
                  fontSize: '0.65rem',
                  fontWeight: 'bold',
                  cursor: 'pointer'
                }}
              >
                {copiedKey === 'manifest' ? 'COPIED' : 'COPY'}
              </button>
            </div>
            <div style={{ fontSize: '0.68rem', color: '#94a3b8', wordBreak: 'break-all' }}>
              {cfg.primaryTier} • ${priceNum} ({cfg.billing})
            </div>
          </div>
        </aside>

        {/* CENTER: ACCESS GATES, PAYMENT RAIL & OFFER STACK */}
        <main
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: '12px',
            backgroundColor: '#0d1015',
            border: '1px solid #1f242d',
            borderRadius: '3px',
            padding: '14px',
            overflowY: 'auto'
          }}
          className="custom-scrollbar"
        >
          <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', borderBottom: '1px solid #1b212c', paddingBottom: '12px' }}>
            <span style={{ fontSize: '0.75rem', fontWeight: 'bold', color: '#DAA520', textTransform: 'uppercase' }}>
              1. ACCESS GATE &amp; PRIMARY OFFER
            </span>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
              <button
                type="button"
                onClick={() => setVal('accessMode', 'MEMBERS_ONLY')}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  gap: '6px',
                  padding: '9px',
                  borderRadius: '3px',
                  fontSize: '0.72rem',
                  fontWeight: 'bold',
                  cursor: 'pointer',
                  border: cfg.accessMode === 'MEMBERS_ONLY' ? '1px solid #DAA520' : '1px solid #222a38',
                  backgroundColor: cfg.accessMode === 'MEMBERS_ONLY' ? 'rgba(218, 165, 32, 0.14)' : '#10141c',
                  color: cfg.accessMode === 'MEMBERS_ONLY' ? '#DAA520' : '#8fa0b5'
                }}
              >
                <Lock style={{ width: '13px', height: '13px' }} />
                <span>MEMBERS-ONLY PORTAL</span>
              </button>

              <button
                type="button"
                onClick={() => setVal('accessMode', 'PUBLIC_CHECKOUT')}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  gap: '6px',
                  padding: '9px',
                  borderRadius: '3px',
                  fontSize: '0.72rem',
                  fontWeight: 'bold',
                  cursor: 'pointer',
                  border: cfg.accessMode === 'PUBLIC_CHECKOUT' ? '1px solid #10b981' : '1px solid #222a38',
                  backgroundColor: cfg.accessMode === 'PUBLIC_CHECKOUT' ? 'rgba(16, 185, 129, 0.14)' : '#10141c',
                  color: cfg.accessMode === 'PUBLIC_CHECKOUT' ? '#10b981' : '#8fa0b5'
                }}
              >
                <Unlock style={{ width: '13px', height: '13px' }} />
                <span>PUBLIC + CHECKOUT</span>
              </button>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 120px 125px', gap: '8px', marginTop: '4px' }}>
              <div>
                <label style={{ fontSize: '0.66rem', color: '#94a3b8', display: 'block', marginBottom: '3px' }}>Primary Tier / Offer</label>
                <input
                  type="text"
                  value={cfg.primaryTier}
                  onChange={(e) => setVal('primaryTier', e.target.value)}
                  style={{
