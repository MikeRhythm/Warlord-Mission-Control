                  }}
                />
              </div>

              <div>
                <label style={{ fontSize: '0.66rem', color: '#94a3b8', display: 'block', marginBottom: '3px' }}>Billing</label>
                <select
                  value={cfg.billing}
                  onChange={(e) => setVal('billing', e.target.value)}
                  style={{
