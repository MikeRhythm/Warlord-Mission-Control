import React, { useState, useEffect } from 'react';

const STATIC_CONFIGS = {
  CHIEF_MADOTHI: { 
    id: 'CHIEF_MADOTHI', 
    label: 'THE CHIEF MADOTHI FUND', 
    color: '#10B981', 
    actionLabel: 'GENERATE DONOR REPORT' 
  },
  PEPTIDES: { 
    id: 'PEPTIDES', 
    label: 'PEPTIDES FOR AFRICA', 
    color: '#38BDF8', 
    actionLabel: 'BUILD PRODUCT DISPATCH' 
  },
  JOHN_TANTON: { 
    id: 'JOHN_TANTON', 
    label: 'JOHN TANTON // PM BOOK', 
    color: '#F97316', 
    actionLabel: 'COMPILE BOOK SECTION' 
  }
};

export default function Tab11Campaigns({ ws }) {
  const [selectedProjectId, setSelectedProjectId] = useState('BOUNTY_ENGINE');
  
  // Bounty State
  const [bounties, setBounties] = useState([]);
  const [activeBountyId, setActiveBountyId] = useState('');

  // Form State
  const [campaignTitle, setCampaignTitle] = useState('');
  const [sourceVideoPath, setSourceVideoPath] = useState('');
  const [hookHeadline, setHookHeadline] = useState('');
  const [startTime, setStartTime] = useState('00:00:00');
  const [endTime, setEndTime] = useState('00:01:00');
  const [cpmRate, setCpmRate] = useState('');
  const [viewFloor, setViewFloor] = useState('');
  const [mandatoryTags, setMandatoryTags] = useState('');

  const [pipelineState, setPipelineState] = useState('IDLE');
  const [renderProgress, setRenderProgress] = useState(0);
  const [telemetryLog, setTelemetryLog] = useState([
    '[INIT] Universal Campaigns & Action Station mounted.',
    '[BRIDGE] Connected to Port 8081 execution conduits.'
  ]);
  const [artifacts, setArtifacts] = useState([]);
  const [isCreatingNew, setIsCreatingNew] = useState(false);

  const addLog = (msg) => {
    setTelemetryLog(prev => [
      `[${new Date().toLocaleTimeString()}] ${msg}`, 
      ...prev.slice(0, 45)
    ]);
  };

  const fetchBounties = async () => {
    try {
      const res = await fetch('http://localhost:8081/api/bounties');
      if (res.ok) {
        const data = await res.json();
        setBounties(data.active || []);
        if (data.active.length > 0 && !activeBountyId) {
          loadBountyIntoForm(data.active[0]);
        }
      }
    } catch (e) {
      addLog(`API ERROR: Could not fetch bounties.`);
    }
  };

  useEffect(() => {
    if (selectedProjectId === 'BOUNTY_ENGINE') {
      fetchBounties();
    }
  }, [selectedProjectId]);

  const loadBountyIntoForm = (bounty) => {
    setActiveBountyId(bounty.id);
    setCampaignTitle(bounty.title);
    setSourceVideoPath(bounty.sourcePath);
    setHookHeadline(bounty.hookHeadline);
    setCpmRate(bounty.cpmRate);
    setViewFloor(bounty.viewFloor);
    setMandatoryTags(bounty.mandatoryTags);
    setIsCreatingNew(false);
    loadDiskArtifacts('BOUNTY_ENGINE', bounty.id);
    addLog(`WORKSPACE: Loaded sub-funnel [${bounty.id}]`);
  };

  const loadDiskArtifacts = async (projId, bId = '') => {
    try {
      const url = projId === 'BOUNTY_ENGINE' 
        ? `http://localhost:8081/api/campaigns/artifacts/${projId}?bountyId=${bId}`
        : `http://localhost:8081/api/campaigns/artifacts/${projId}`;
      const res = await fetch(url);
      if (res.ok) {
        const data = await res.json();
        setArtifacts(data.artifacts || []);
        addLog(`DISK SYNC: Loaded ${data.count} artifacts.`);
      }
    } catch (e) {
      addLog(`DISK ERROR: ${e.message}`);
    }
  };

  const handleCreateBounty = async () => {
    const slug = campaignTitle.replace(/\s+/g, '_').toLowerCase();
    try {
      const res = await fetch('http://localhost:8081/api/bounties', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: slug, 
          title: campaignTitle, 
          cpmRate, 
          viewFloor, 
          mandatoryTags, 
          hookHeadline, 
          sourcePath: sourceVideoPath
        })
      });
      const data = await res.json();
      if (data.success) {
        addLog(`CREATED: New bounty ledger & disk tree for [${slug}]`);
        await fetchBounties();
        loadBountyIntoForm(data.bounty);
      }
    } catch (e) {
      addLog(`CREATE ERROR: ${e.message}`);
    }
  };

  const handleDeleteBounty = async () => {
    if (!activeBountyId) return;
    if (!window.confirm(`WARNING: This will permanently delete bounty [${activeBountyId}] and obliterate all MP4 clips off the disk. Proceed?`)) return;
    
    try {
      const res = await fetch(`http://localhost:8081/api/bounties/${activeBountyId}`, { 
        method: 'DELETE' 
      });
      if (res.ok) {
        addLog(`PURGED: Obliterated ledger & disk files for [${activeBountyId}]`);
        setActiveBountyId('');
        setArtifacts([]);
        await fetchBounties();
      }
    } catch (e) {
      addLog(`PURGE ERROR: ${e.message}`);
    }
  };

  const handleExecute = async () => {
    setPipelineState('PROCESSING');
    setRenderProgress(25);
    addLog(`PIPELINE ENGAGED.`);

    if (selectedProjectId === 'BOUNTY_ENGINE') {
      try {
        const response = await fetch('http://localhost:8081/api/campaigns/bounty/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sourceFile: sourceVideoPath, 
            hookText: hookHeadline,
            startTimestamp: startTime, 
            endTimestamp: endTime,
            outputFilename: `clip_${Date.now()}_hooked.mp4`,
            bountyId: activeBountyId
          })
        });

        const data = await response.json();
        setRenderProgress(100);

        if (data.success) {
          setPipelineState('COMPLETE');
          addLog(`RENDER COMMITTED: Saved ${data.filename}`);
          loadDiskArtifacts('BOUNTY_ENGINE', activeBountyId);
        } else {
          setPipelineState('FAILED');
          addLog(`FFMPEG FAILED: ${data.error}`);
        }
      } catch (err) {
        setPipelineState('FAILED');
        addLog(`CONDUIT ERROR: ${err.message}`);
      }
    } else {
      setTimeout(() => {
        setRenderProgress(100);
        setPipelineState('COMPLETE');
        addLog(`ACTION PACKET DISPATCHED: Handled via MCNC Agent Bus for ${selectedProjectId}`);
      }, 1200);
    }
  };

  const getPrimaryColor = () => {
    return selectedProjectId === 'BOUNTY_ENGINE' 
      ? '#DAA520' 
      : STATIC_CONFIGS[selectedProjectId]?.color || '#DAA520';
  };

  return (
    <div style={{ 
      display: 'flex', 
      flexDirection: 'column', 
      height: '100%', 
      width: '100%', 
      backgroundColor: '#07090E', 
      color: '#E2E8F0', 
      fontFamily: "'JetBrains Mono', monospace", 
      padding: '14px', 
      boxSizing: 'border-box', 
      gap: '14px', 
      overflow: 'hidden' 
    }}>

      {/* TOP DECK: PROJECT CONTEXT SELECTOR */}
      <div style={{ 
        display: 'flex', 
        alignItems: 'center', 
        justifyContent: 'space-between', 
        padding: '10px 16px', 
        backgroundColor: '#0B0F17', 
        border: '1px solid #1E293B', 
        borderRadius: '6px' 
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '14px' }}>
          <span style={{ color: '#DAA520', fontWeight: 'bold', fontSize: '12px', letterSpacing: '1px' }}>
            ACTION STATION //
          </span>
          <div style={{ display: 'flex', gap: '8px' }}>
            <button
              onClick={() => setSelectedProjectId('BOUNTY_ENGINE')}
              style={{
                backgroundColor: selectedProjectId === 'BOUNTY_ENGINE' ? 'rgba(218, 165, 32, 0.15)' : '#070A0F',
                border: selectedProjectId === 'BOUNTY_ENGINE' ? '1px solid #DAA520' : '1px solid #1E293B',
                color: selectedProjectId === 'BOUNTY_ENGINE' ? '#DAA520' : '#94A3B8',
                padding: '5px 12px', 
                borderRadius: '4px', 
                fontSize: '11px', 
                fontWeight: selectedProjectId === 'BOUNTY_ENGINE' ? '700' : '500', 
                cursor: 'pointer'
              }}
            >
              CREATOR BOUNTIES
            </button>
            {Object.values(STATIC_CONFIGS).map(proj => (
              <button 
                key={proj.id} 
                onClick={() => { 
                  setSelectedProjectId(proj.id); 
                  setArtifacts([]); 
                }}
                style={{
                  backgroundColor: selectedProjectId === proj.id ? `rgba(255,255,255,0.05)` : '#070A0F',
                  border: selectedProjectId === proj.id ? `1px solid ${proj.color}` : '1px solid #1E293B',
                  color: selectedProjectId === proj.id ? proj.color : '#94A3B8',
                  padding: '5px 12px', 
                  borderRadius: '4px', 
                  fontSize: '11px', 
                  fontWeight: selectedProjectId === proj.id ? '700' : '500', 
                  cursor: 'pointer'
                }}
              >
                {proj.label}
              </button>
            ))}
          </div>
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: '12px', fontSize: '11px', color: '#64748b' }}>
          <span>PORT 8081 DAEMON: <strong style={{ color: '#10B981' }}>READY</strong></span>
          <span>WHISPER CLUSTER: <strong style={{ color: '#DAA520' }}>NIM ONLINE</strong></span>
        </div>
      </div>

      {/* SUB-FUNNEL SELECTOR FOR BOUNTIES */}
      {selectedProjectId === 'BOUNTY_ENGINE' && (
        <div style={{ 
          display: 'flex', 
          alignItems: 'center', 
          gap: '10px', 
          padding: '10px 16px', 
          backgroundColor: '#070A0F', 
          border: '1px solid #1E293B', 
          borderRadius: '6px' 
        }}>
          <span style={{ fontSize: '10px', color: '#64748B' }}>ACTIVE BOUNTIES:</span>
          {bounties.map(b => (
            <button 
              key={b.id} 
              onClick={() => loadBountyIntoForm(b)}
              style={{
                background: activeBountyId === b.id ? 'rgba(218, 165, 32, 0.2)' : 'transparent',
                border: activeBountyId === b.id ? '1px solid #DAA520' : '1px solid #1E293B',
                color: activeBountyId === b.id ? '#DAA520' : '#94A3B8',
                padding: '4px 10px', 
                fontSize: '10px', 
                borderRadius: '4px', 
                cursor: 'pointer'
              }}
            >
              {b.title}
            </button>
          ))}
          <button 
            onClick={() => { 
              setIsCreatingNew(true); 
              setActiveBountyId(''); 
              setCampaignTitle(''); 
              setArtifacts([]); 
            }}
            style={{ 
              background: '#1E293B', 
              border: 'none', 
              color: '#F8FAFC', 
              padding: '4px 10px', 
              fontSize: '10px', 
              borderRadius: '4px', 
              cursor: 'pointer' 
            }}
          >
            + NEW FUNNEL
          </button>
        </div>
      )}

      {/* MASTER 3-COLUMN COCKPIT */}
      <div style={{ display: 'grid', gridTemplateColumns: '1.1fr 1fr 1.1fr', gap: '14px', flex: 1, minHeight: 0 }}>
        
        {/* COLUMN 1: RULES & INPUT */}
        <div style={{ 
          backgroundColor: '#0B0F17', 
          border: '1px solid #1E293B', 
          borderRadius: '6px', 
          padding: '16px', 
          display: 'flex', 
          flexDirection: 'column', 
          gap: '12px', 
          overflowY: 'auto' 
        }}>
          <div style={{ 
            color: getPrimaryColor(), 
            fontSize: '11px', 
            fontWeight: 'bold', 
            borderBottom: '1px solid #1E293B', 
            paddingBottom: '6px', 
            display: 'flex', 
            justifyContent: 'space-between',
            alignItems: 'center'
          }}>
            <span>01 // {selectedProjectId === 'BOUNTY_ENGINE' ? 'BOUNTY RULES' : STATIC_CONFIGS[selectedProjectId]?.label}</span>
            {selectedProjectId === 'BOUNTY_ENGINE' && activeBountyId && !isCreatingNew && (
              <button 
                onClick={handleDeleteBounty} 
                style={{ 
                  background: 'transparent', 
                  border: 'none', 
                  color: '#EF4444', 
                  fontSize: '10px', 
                  fontWeight: 'bold',
                  cursor: 'pointer' 
                }}
              >
                [ PURGE FUNNEL ]
              </button>
            )}
          </div>

          <div>
            <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>Campaign Target</label>
            <input 
              type="text" 
              value={campaignTitle} 
              onChange={(e) => setCampaignTitle(e.target.value)} 
              style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#F8FAFC', padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box' }}
            />
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
            <div>
              <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>CPM Rate</label>
              <input 
                type="text" 
                value={cpmRate} 
                onChange={(e) => setCpmRate(e.target.value)} 
                style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#10B981', padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box', fontWeight: 'bold' }}
              />
            </div>
            <div>
              <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>View Floor</label>
              <input 
                type="text" 
                value={viewFloor} 
                onChange={(e) => setViewFloor(e.target.value)} 
                style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#DAA520', padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box', fontWeight: 'bold' }}
              />
            </div>
          </div>

          <div>
            <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>Source Path</label>
            <input 
              type="text" 
              value={sourceVideoPath} 
              onChange={(e) => setSourceVideoPath(e.target.value)} 
              style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#F8FAFC', padding: '8px', borderRadius: '4px', fontSize: '11px', marginTop: '4px', boxSizing: 'border-box' }}
            />
          </div>

          <div>
            <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>Hook Headline</label>
            <input 
              type="text" 
              value={hookHeadline} 
              onChange={(e) => setHookHeadline(e.target.value)} 
              style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: getPrimaryColor(), padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box', fontWeight: 'bold' }}
            />
          </div>
          
          {selectedProjectId === 'BOUNTY_ENGINE' && (
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px' }}>
              <div>
                <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>Start Time</label>
                <input 
                  type="text" 
                  value={startTime} 
                  onChange={(e) => setStartTime(e.target.value)} 
                  style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#F8FAFC', padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box' }}
                />
              </div>
              <div>
                <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>End Time</label>
                <input 
                  type="text" 
                  value={endTime} 
                  onChange={(e) => setEndTime(e.target.value)} 
                  style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#F8FAFC', padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box' }}
                />
              </div>
            </div>
          )}
          
          <div>
            <label style={{ fontSize: '10px', color: '#94A3B8', textTransform: 'uppercase' }}>Mandatory Tags</label>
            <input 
              type="text" 
              value={mandatoryTags} 
              onChange={(e) => setMandatoryTags(e.target.value)} 
              style={{ width: '100%', backgroundColor: '#070A0F', border: '1px solid #1E293B', color: '#38BDF8', padding: '8px', borderRadius: '4px', fontSize: '12px', marginTop: '4px', boxSizing: 'border-box' }}
            />
          </div>

          {selectedProjectId === 'BOUNTY_ENGINE' && isCreatingNew ? (
            <button 
              onClick={handleCreateBounty} 
              style={{ 
                marginTop: 'auto', 
                backgroundColor: '#10B981', 
                color: '#070A0F', 
                border: 'none', 
                padding: '12px', 
                borderRadius: '4px', 
                fontWeight: 'bold', 
                fontSize: '12px', 
                letterSpacing: '1px',
                cursor: 'pointer' 
              }}
            >
              SAVE &amp; INITIALIZE NEW FUNNEL
            </button>
          ) : (
            <button 
              onClick={handleExecute} 
              disabled={pipelineState === 'PROCESSING'} 
              style={{ 
                marginTop: 'auto', 
                backgroundColor: pipelineState === 'PROCESSING' ? '#1E293B' : getPrimaryColor(), 
                color: '#070A0F', 
                border: 'none', 
                padding: '12px', 
                borderRadius: '4px', 
                fontWeight: 'bold', 
                fontSize: '12px', 
                letterSpacing: '1px',
                cursor: pipelineState === 'PROCESSING' ? 'not-allowed' : 'pointer' 
              }}
            >
              {pipelineState === 'PROCESSING' ? 'PROCESSING...' : selectedProjectId === 'BOUNTY_ENGINE' ? 'EXECUTE BOUNTY CUT' : STATIC_CONFIGS[selectedProjectId]?.actionLabel}
            </button>
          )}
        </div>

        {/* COLUMN 2: TELEMETRY */}
        <div style={{ 
          backgroundColor: '#0B0F17', 
          border: '1px solid #1E293B', 
          borderRadius: '6px', 
          padding: '16px', 
          display: 'flex', 
          flexDirection: 'column', 
          gap: '12px' 
        }}>
          <div style={{ 
            color: getPrimaryColor(), 
            fontSize: '11px', 
            fontWeight: 'bold', 
            borderBottom: '1px solid #1E293B', 
            paddingBottom: '6px', 
            display: 'flex', 
            justifyContent: 'space-between' 
          }}>
            <span>02 // TELEMETRY</span>
            <span style={{ color: pipelineState === 'PROCESSING' ? '#38BDF8' : '#64748B' }}>
              [{pipelineState}]
            </span>
          </div>

          <div style={{ width: '100%', backgroundColor: '#070A0F', height: '6px', borderRadius: '3px', overflow: 'hidden' }}>
            <div style={{ 
              width: `${renderProgress}%`, 
              height: '100%', 
              backgroundColor: getPrimaryColor(), 
              transition: 'width 0.4s ease' 
            }} />
          </div>

          <div style={{ 
            flex: 1, 
            backgroundColor: '#05070B', 
            border: '1px solid #141C2B', 
            borderRadius: '4px', 
            padding: '10px', 
            fontSize: '11px', 
            lineHeight: '1.6', 
            color: '#94A3B8', 
            overflowY: 'auto', 
            display: 'flex', 
            flexDirection: 'column', 
            gap: '4px' 
          }}>
            {telemetryLog.map((log, i) => (
              <div 
                key={i} 
                style={{ 
                  color: log.includes('SUCCESS') || log.includes('COMMITTED') || log.includes('CREATED') 
                    ? '#10B981' 
                    : log.includes('PURGED') || log.includes('ERROR') 
                    ? '#EF4444' 
                    : '#94A3B8' 
                }}
              >
                {log}
              </div>
            ))}
          </div>
        </div>

        {/* COLUMN 3: DISK ARTIFACTS */}
        <div style={{ 
          backgroundColor: '#0B0F17', 
          border: '1px solid #1E293B', 
          borderRadius: '6px', 
          padding: '16px', 
          display: 'flex', 
          flexDirection: 'column', 
          gap: '12px', 
          overflowY: 'auto' 
        }}>
          <div style={{ 
            color: getPrimaryColor(), 
            fontSize: '11px', 
            fontWeight: 'bold', 
            borderBottom: '1px solid #1E293B', 
            paddingBottom: '6px', 
            display: 'flex', 
            justifyContent: 'space-between',
            alignItems: 'center'
          }}>
            <span>03 // DISK ARTIFACTS ({artifacts.length})</span>
            <button 
              onClick={() => loadDiskArtifacts(selectedProjectId, activeBountyId)} 
              style={{ background: 'none', border: 'none', color: '#38BDF8', cursor: 'pointer', fontSize: '10px' }}
            >
              [SCAN DISK]
            </button>
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
            {artifacts.length === 0 ? (
              <div style={{ color: '#64748B', fontSize: '11px', textAlign: 'center', marginTop: '20px' }}>
                No physical artifacts found in workspace.
              </div>
            ) : (
              artifacts.map(art => (
                <div 
                  key={art.id} 
                  style={{ 
                    backgroundColor: '#070A0F', 
                    border: '1px solid #1E293B', 
                    borderRadius: '4px', 
                    padding: '10px', 
                    display: 'flex', 
                    flexDirection: 'column', 
                    gap: '6px' 
                  }}
                >
                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                    <span style={{ fontSize: '11px', color: '#F8FAFC', fontWeight: 'bold' }}>
                      {art.name}
                    </span>
                    <span style={{ 
                      fontSize: '9px', 
                      padding: '2px 6px', 
                      borderRadius: '3px', 
                      backgroundColor: 'rgba(16, 185, 129, 0.2)', 
                      color: '#10B981', 
                      border: '1px solid #10B981' 
                    }}>
                      {art.sizeKb} KB
                    </span>
                  </div>

                  <div style={{ fontSize: '10px', color: '#64748B', display: 'flex', justifyContent: 'space-between' }}>
                    <span>MODIFIED: {art.modified}</span>
                    <span>STATE: VERIFIED</span>
                  </div>

                  <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '6px', marginTop: '4px' }}>
                    <button 
                      onClick={() => navigator.clipboard.writeText(`${hookHeadline} #Shorts ${mandatoryTags}`)} 
                      style={{ backgroundColor: '#1E293B', border: 'none', color: '#E2E8F0', padding: '5px', fontSize: '10px', borderRadius: '3px', cursor: 'pointer' }}
                    >
                      COPY TITLE
                    </button>
                    <button 
                      onClick={() => navigator.clipboard.writeText(`${campaignTitle}\n\n${mandatoryTags}`)} 
                      style={{ backgroundColor: '#1E293B', border: 'none', color: '#E2E8F0', padding: '5px', fontSize: '10px', borderRadius: '3px', cursor: 'pointer' }}
                    >
                      COPY DESC
                    </button>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

      </div>
    </div>
  );
}