<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WARLORD MISSION CONTROL // MCNC MASTER</title>
    
    <!-- MANDATED TYPOGRAPHY -->
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- SURVIVING EXTERNAL STYLESHEET -->
    <link rel="stylesheet" href="/style.css">
    
    <style>
        /* WARLORD TIER 4: HIGH FINANCE VISUAL STANDARD */
        :root {
            --bg-obsidian: #0B0E14;
            --text-glint: #E2E8F0;
            --text-mist: #94A3B8;
            --gold-core: #DAA520;
            --emerald-core: #10B981;
            --ruby-core: #EF4444;
            
            /* Glassmorphism Underlays */
            --glass-emerald: rgba(16, 185, 129, 0.1);
            --glass-ruby: rgba(239, 68, 68, 0.1);
            --glass-panel: rgba(15, 23, 42, 0.6);
            --border-dim: rgba(148, 163, 184, 0.1);
        }

        body {
            background-color: var(--bg-obsidian);
            color: var(--text-glint);
            font-family: 'JetBrains Mono', monospace;
            margin: 0;
            padding: 0;
            height: 100vh;        /* THE MASTER LOCK */
            overflow: hidden;     /* KILLS GLOBAL SCROLLING */
            display: flex;
            flex-direction: column;
        }

        /* MASTER NAVIGATION DECK */
        .mcnc-top-nav {
            display: flex;
            background: #080A0E;
            border-bottom: 1px solid var(--border-dim);
            padding: 12px 20px;
            gap: 8px;
            align-items: center;
            flex-wrap: nowrap;
            overflow-x: auto;
            flex-shrink: 0;       /* PREVENTS CRUSHING */
        }
        
        .nav-header {
            color: var(--text-glint);
            font-weight: 700;
            font-size: 0.85rem;
            margin-right: 15px;
            letter-spacing: 1.5px;
            white-space: nowrap;
        }

        .nav-tab {
            background: var(--glass-panel);
            border: 1px solid var(--border-dim);
            color: var(--text-mist);
            padding: 8px 14px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s;
            white-space: nowrap;
            border-radius: 2px;
        }

        .nav-tab:hover {
            border-color: var(--text-glint);
            color: var(--text-glint);
        }

        .nav-tab.active {
            border-color: var(--gold-core);
            color: var(--gold-core);
            background: rgba(218, 165, 32, 0.05);
            box-shadow: inset 0 -2px 0 var(--gold-core);
        }

        /* DREADNOUGHT VIEWPORT MATRIX */
        .mcnc-viewport {
            display: flex;
            flex: 1;              /* FILLS REMAINING SPACE EXACTLY */
            overflow: hidden;     /* PASSES SCROLL TO 01 EXEC TERMINAL */
            background: radial-gradient(circle at top right, rgba(218,165,32,0.03), transparent 50%);
        }

        /* GLOBAL RESET FOR NATIVE SCROLLBARS */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-obsidian); }
        ::-webkit-scrollbar-thumb { background: var(--border-dim); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-mist); }
    </style>

    <!-- GLOBAL DICTATION STYLES -->
    <style>
        .mcnc-prompt-wrapper {
            position: relative;
            width: 100%;
            margin-bottom: 10px;
        }
        .warlord-mic-btn {
            position: absolute;
            bottom: 15px;
            right: 15px;
            background: transparent;
            border: none;
            cursor: pointer;
            outline: none;
            padding: 5px;
            z-index: 10;
        }
        .warlord-mic-btn svg {
            width: 20px;
            height: 20px;
            fill: #888; /* Idle Grey */
            transition: fill 0.2s ease, transform 0.2s ease;
        }
        .warlord-mic-btn.listening svg {
            fill: #FF0000; /* Active Red */
            transform: scale(1.1);
        }
        @keyframes pulseRed {
            0% { filter: drop-shadow(0 0 2px #FF0000); }
            50% { filter: drop-shadow(0 0 8px #FF0000); }
            100% { filter: drop-shadow(0 0 2px #FF0000); }
        }
        .warlord-mic-btn.listening {
            animation: pulseRed 1.5s infinite;
        }
    </style>
</head>
<body>
    <!-- 13-PAGE MASTER NAVIGATION DECK -->
    <div class="mcnc-top-nav">
        <div class="nav-header">WARLORD MISSION CONTROL //</div>
        <a href="/exec" class="nav-tab <%= activeView === 'partials/tab_01_exec' ? 'active' : '' %>">01 EXEC</a>
        <a href="/warroom" class="nav-tab <%= activeView === 'partials/tab_02_warroom' ? 'active' : '' %>">02 WAR ROOM</a>
        <a href="/projects" class="nav-tab <%= activeView === 'partials/tab_03_projects' ? 'active' : '' %>">03 PROJECTS</a>
        <a href="/taskboard" class="nav-tab <%= activeView === 'partials/tab_04_taskboard' ? 'active' : '' %>">04 TASK BOARD</a>
        <a href="/calendar" class="nav-tab <%= activeView === 'partials/tab_05_calendar' ? 'active' : '' %>">05 CALENDAR</a>
        <a href="/memory" class="nav-tab <%= activeView === 'partials/tab_06_memory' ? 'active' : '' %>">06 MEMORY</a>
        <a href="/paperclip" class="nav-tab <%= activeView === 'partials/tab_07_paperclip' ? 'active' : '' %>">07 PAPERCLIP</a>
        <a href="/palettes" class="nav-tab <%= activeView === 'partials/tab_08_palettes' ? 'active' : '' %>">08 PALETTES</a>
        <a href="/org" class="nav-tab <%= activeView === 'partials/tab_09_org' ? 'active' : '' %>">09 ORG</a>
        <a href="/office" class="nav-tab <%= activeView === 'partials/tab_10_office' ? 'active' : '' %>">10 OFFICE</a>
        <a href="/galaxy" class="nav-tab <%= activeView === 'partials/tab_11_galaxy' ? 'active' : '' %>">11 GALAXY</a>
        <a href="/review" class="nav-tab <%= activeView === 'partials/tab_12_reviewmedia' ? 'active' : '' %>">12 REVIEW</a>
        <a href="/docs" class="nav-tab <%= activeView === 'partials/tab_13_docs' ? 'active' : '' %>">13 DOCS</a>
    </div>

    <div class="mcnc-viewport">
        <!-- INJECTS ACTIVE MODULAR VIEW -->
        <%- include(activeView) %>
    </div>

    <!-- SURVIVING ENGINE LOGIC -->
    <script src="/mcnc_logic.js"></script>

    <!-- GLOBAL DICTATION SCRIPT -->
    <script src="/warlord-dictation.js"></script>
</body>
</html>