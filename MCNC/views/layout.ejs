<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WARLORD MISSION CONTROL // MCNC MASTER</title>
    
    <!-- MANDATED TYPOGRAPHY -->
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- SURVIVING EXTERNAL STYLESHEET -->
    <link rel="stylesheet" href="/style.css">
    
    <style>
        /* WARLORD TIER 4: HIGH FINANCE VISUAL STANDARD */
        :root {
            --bg-obsidian: #0B0E14;
            --text-glint: #E2E8F0;
            --text-mist: #94A3B8;
            --gold-core: #DAA520;
            --emerald-core: #10B981;
            --ruby-core: #EF4444;
            
            /* Glassmorphism Underlays */
            --glass-emerald: rgba(16, 185, 129, 0.1);
            --glass-ruby: rgba(239, 68, 68, 0.1);
            --glass-panel: rgba(15, 23, 42, 0.6);
            --border-dim: rgba(148, 163, 184, 0.1);
        }

        body {
            background-color: var(--bg-obsidian);
            color: var(--text-glint);
            font-family: 'JetBrains Mono', monospace;
            margin: 0;
            padding: 0;
            height: 100vh;        /* THE MASTER LOCK */
            overflow: hidden;     /* KILLS GLOBAL SCROLLING */
            display: flex;
            flex-direction: column;
        }

        /* High Finance Master Header & Pill Navigation */
        .mcnc-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            background: #0d0f12;
            border-bottom: 1px solid #1f242d;
            font-family: 'Consolas', 'Courier New', monospace;
        }
        .nav-branding {
            color: #ffb800;
            font-weight: 800;
            font-size: 13px;
            letter-spacing: 1px;
        }
        .nav-telemetry {
            color: #5c6b7f;
            font-size: 11px;
            letter-spacing: 0.5px;
        }
        .mcnc-top-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 10px 16px;
            background: #080a0c;
            border-bottom: 2px solid #14181f;
            align-items: center;
        }
        .nav-tab {
            display: inline-block;
            padding: 6px 14px;
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 4px;
            letter-spacing: 0.5px;
            transition: all 0.2s ease-in-out;
            border: 1px solid transparent;
        }

        /* Default / Dark Obsidian Tabs */
        .nav-tab.tab-obsidian {
            background: #14171c;
            color: #a0aec0;
            border: 1px solid #232832;
        }
        .nav-tab.tab-obsidian:hover {
            background: #1c2129;
            color: #ffffff;
            border-color: #3b4252;
        }

        /* Steel Teal / Slate Blue Tabs */
        .nav-tab.tab-teal {
            background: #2b4c59;
            color: #e2e8f0;
            border: 1px solid #3d6a7d;
        }
        .nav-tab.tab-teal:hover {
            background: #365e6f;
            color: #ffffff;
        }

        /* Bronze / Rose Tint Tabs */
        .nav-tab.tab-bronze {
            background: #4a3838;
            color: #e2e8f0;
            border: 1px solid #664d4d;
        }
        .nav-tab.tab-bronze:hover {
            background: #5c4545;
            color: #ffffff;
        }

        /* Crimson / Ruby Tab */
        .nav-tab.tab-ruby {
            background: #592525;
            color: #fca5a5;
            border: 1px solid #7f3535;
        }
        .nav-tab.tab-ruby:hover {
            background: #6e2e2e;
            color: #ffffff;
        }

        /* Brass / Olive Gold Tab */
        .nav-tab.tab-brass {
            background: #4d4930;
            color: #fef08a;
            border: 1px solid #6b6643;
        }
        .nav-tab.tab-brass:hover {
            background: #5c583a;
            color: #ffffff;
        }

        /* Active Highlight (Gold Core) */
        .nav-tab.active {
            background: #0d0f12 !important;
            color: #ffb800 !important;
            border: 2px solid #ffb800 !important;
            box-shadow: 0 0 8px rgba(255, 184, 0, 0.4);
        }

        /* DREADNOUGHT VIEWPORT MATRIX */
        .mcnc-viewport {
            display: flex;
            flex: 1;              /* FILLS REMAINING SPACE EXACTLY */
            overflow: hidden;     /* PASSES SCROLL TO 01 EXEC TERMINAL */
            background: radial-gradient(circle at top right, rgba(218,165,32,0.03), transparent 50%);
        }

        /* GLOBAL RESET FOR NATIVE SCROLLBARS */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-obsidian); }
        ::-webkit-scrollbar-thumb { background: var(--border-dim); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-mist); }
    </style>

    <!-- GLOBAL DICTATION STYLES -->
    <style>
        .mcnc-prompt-wrapper {
            position: relative;
            width: 100%;
            margin-bottom: 10px;
        }
        .warlord-mic-btn {
            position: absolute;
            bottom: 15px;
            right: 15px;
            background: transparent;
            border: none;
            cursor: pointer;
            outline: none;
            padding: 5px;
            z-index: 10;
        }
        .warlord-mic-btn svg {
            width: 20px;
            height: 20px;
            fill: #888; /* Idle Grey */
            transition: fill 0.2s ease, transform 0.2s ease;
        }
        .warlord-mic-btn.listening svg {
            fill: #FF0000; /* Active Red */
            transform: scale(1.1);
        }
        @keyframes pulseRed {
            0% { filter: drop-shadow(0 0 2px #FF0000); }
            50% { filter: drop-shadow(0 0 8px #FF0000); }
            100% { filter: drop-shadow(0 0 2px #FF0000); }
        }
        .warlord-mic-btn.listening {
            animation: pulseRed 1.5s infinite;
        }
    </style>
</head>
<body>
    <!-- High Finance Master Header & Pill Navigation -->
    <div class="mcnc-top-bar">
        <div class="nav-branding">WARLORD MISSION CONTROL // MCNC MASTER</div>
        <div class="nav-telemetry">BRIDGE: ACTIVE (BASE 1) | SYSTEM READY</div>
    </div>

    <div class="mcnc-top-nav">
        <a href="/exec" class="nav-tab tab-obsidian <%= activeView === 'partials/tab_01_exec' ? 'active' : '' %>">01 EXEC</a>
        <a href="/warroom" class="nav-tab tab-obsidian <%= activeView === 'partials/tab_02_war_room' ? 'active' : '' %>">02 WAR ROOM</a>
        <a href="/projects" class="nav-tab tab-teal <%= activeView === 'partials/tab_03_projects' ? 'active' : '' %>">03 PROJECTS</a>
        <a href="/taskboard" class="nav-tab tab-teal <%= activeView === 'partials/tab_04_taskboard' ? 'active' : '' %>">04 TASK BOARD</a>
        <a href="/calendar" class="nav-tab tab-teal <%= activeView === 'partials/tab_05_calendar' ? 'active' : '' %>">05 CALENDAR</a>
        <a href="/memory" class="nav-tab tab-obsidian <%= activeView === 'partials/tab_06_memory' ? 'active' : '' %>">06 MEMORY</a>
        <a href="/paperclip" class="nav-tab tab-teal <%= activeView === 'partials/tab_07_paperclip' ? 'active' : '' %>">07 PAPERCLIP</a>
        <a href="/palettes" class="nav-tab tab-ruby <%= activeView === 'partials/tab_08_palettes' ? 'active' : '' %>">08 PALETTES</a>
        <a href="/org" class="nav-tab tab-obsidian <%= activeView === 'partials/tab_09_org' ? 'active' : '' %>">09 ORG</a>
        <a href="/tokens" class="nav-tab tab-bronze <%= activeView === 'partials/tab_10_tokens' ? 'active' : '' %>">10 TOKENS</a>
        <a href="/galaxy" class="nav-tab tab-brass <%= activeView === 'partials/tab_11_galaxy' ? 'active' : '' %>">11 GALAXY</a>
        <a href="/review" class="nav-tab tab-bronze <%= activeView === 'partials/tab_12_reviewmedia' ? 'active' : '' %>">12 REVIEW</a>
        <a href="/docs" class="nav-tab tab-bronze <%= activeView === 'partials/tab_13_docs' ? 'active' : '' %>">13 DOCS</a>
        <a href="/other" class="nav-tab tab-obsidian <%= activeView === 'partials/tab_14_other' ? 'active' : '' %>">14 OTHER</a>
    </div>

    <div class="mcnc-viewport">
        <!-- INJECTS ACTIVE MODULAR VIEW -->
        <%- include(activeView) %>
    </div>

    <!-- SURVIVING ENGINE LOGIC -->
    <script src="/mcnc_logic.js"></script>

    <!-- GLOBAL DICTATION SCRIPT -->
    <script src="/warlord-dictation.js"></script>
</body>
</html>