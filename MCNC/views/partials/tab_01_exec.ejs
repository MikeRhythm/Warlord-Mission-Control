</div>

<!-- CLIENT-SIDE SCRIPT LOGIC -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const state = {
            provider: 'ollama',
            model: 'oamazonasgabriel/lfm2.5-2.6b:q4_k_m-8gbGPU',
            modelLabel: 'LFM-2.5',
            project: 'RHYTHM',
            attachments: []
        };

        const modelButtons = document.querySelectorAll('.model-btn');
        const pipelineBanner = document.getElementById('pipelineBanner');
        const statusPill = document.getElementById('statusPill');
        const terminalViewport = document.getElementById('terminalViewport');
        const promptInput = document.getElementById('execPromptInput');
        const micBtn = document.getElementById('micBtn');
        
        // ==========================================================================
        // REAL-TIME NATIVE WEB SPEECH DICTATION (ZERO LATENCY)
        // ==========================================================================
        let recognition;
        let isRecording = false;

        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onstart = () => {
                isRecording = true;
                micBtn.classList.add('recording');
            };

            recognition.onresult = (event) => {
                let finalTranscript = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    if (event.results[i].isFinal) {
                        finalTranscript += event.results[i][0].transcript;
                    }
                }
                if (finalTranscript) {
                    promptInput.value += (promptInput.value.trim() === '' ? '' : ' ') + finalTranscript.trim() + ' ';
                }
            };

            recognition.onerror = (event) => {
                console.error("[MCNC] Speech recognition error:", event.error);
                isRecording = false;
                micBtn.classList.remove('recording');
            };

            recognition.onend = () => {
                isRecording = false;
                micBtn.classList.remove('recording');
            };

            micBtn.addEventListener('click', () => {
                if (isRecording) {
                    recognition.stop();
                } else {
                    promptInput.focus();
                    recognition.start();
                }
            });
        } else {
            micBtn.addEventListener('click', () => {
                alert("NATIVE DICTATION FAILED: Web Speech API is not supported in this browser. Use Chrome or Edge.");
            });
        }

        // ==========================================================================
        // UI INTERACTIONS & SUBMISSION PIPELINE
        // ==========================================================================
        modelButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                modelButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                state.provider = btn.dataset.provider;
                state.model = btn.dataset.model;
                state.modelLabel = btn.dataset.label;

                pipelineBanner.textContent = `ACTIVE PIPELINE // [ ${state.provider.toUpperCase()}: ${state.modelLabel} ACTIVE ]`;
                statusPill.textContent = `MONTY 2 // [ ${state.provider.toUpperCase()}: ${state.modelLabel} ]`;

                appendMessage('SYSTEM', `Provider switched to ${state.provider.toUpperCase()} (${state.modelLabel})`, 'system');
            });
        });

        function appendMessage(sender, text, type = 'monty') {
            const msgBlock = document.createElement('div');
            msgBlock.className = `message-block ${type}`;
            const header = document.createElement('div');
            header.className = `message-header ${type}`;
            const timestamp = new Date().toLocaleTimeString();

            if (type === 'warlord') {
                header.innerHTML = `MIKE // WARLORD: <span class="message-timestamp">${timestamp}</span>`;
                header.style.color = "var(--emerald-core)";
            } else if (type === 'monty') {
                header.innerHTML = `CHIEF OF STAFF // MONTY 2: <span class="message-timestamp">${timestamp}</span>`;
                header.style.color = "var(--gold-core)";
            } else if (type === 'system-error') {
                header.innerHTML = `[SYSTEM BRIDGE FAILED]: <span class="message-timestamp">${timestamp}</span>`;
                header.style.color = "var(--ruby-core)";
            } else {
                header.innerHTML = `[SYSTEM TELEMETRY]: <span class="message-timestamp">${timestamp}</span>`;
                header.style.color = "var(--text-mist)";
            }

            const content = document.createElement('div');
            content.className = 'message-content';
            content.style.marginTop = '4px';
            content.style.whiteSpace = 'pre-wrap';
            content.textContent = text;

            msgBlock.appendChild(header);
            msgBlock.appendChild(content);
            msgBlock.style.marginBottom = '16px';

            terminalViewport.appendChild(msgBlock);
            terminalViewport.scrollTop = terminalViewport.scrollHeight;
        }

        async function submitPrompt() {
            const text = promptInput.value.trim();
            if (!text && state.attachments.length === 0) return;

            appendMessage('MIKE // WARLORD', text, 'warlord');
            promptInput.value = '';

            // Stop recording on submit if it was active
            if (isRecording && recognition) {
                recognition.stop();
            }

            // --- THE MASSIVE TACTICAL LOADER ---
            const loaderId = 'loader-' + Date.now();
            const loaderBlock = document.createElement('div');
            loaderBlock.id = loaderId;
            loaderBlock.className = 'heavy-loader-block';
            
            loaderBlock.innerHTML = `
                <div class="massive-spinner"></div>
                <div class="heavy-loader-text">
                    MONTY IS PROCESSING PAYLOAD... <br>
                    <span style="font-size: 24px; color: #fff;" id="timer-${loaderId}">0.0</span>s
                </div>
            `;
            terminalViewport.appendChild(loaderBlock);
            terminalViewport.scrollTop = terminalViewport.scrollHeight;

            let startTime = Date.now();
            
            let timerInterval = setInterval(() => {
                let elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
                const timerSpan = document.getElementById(`timer-${loaderId}`);
                if (timerSpan) timerSpan.innerText = elapsed;
            }, 100);

            try {
                const response = await fetch('/api/exec/prompt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        provider: state.provider,
                        model: state.model,
                        prompt: text,
                        project: state.project,
                        attachments: state.attachments
                    })
                });

                const data = await response.json();

                clearInterval(timerInterval);
                const loaderEl = document.getElementById(loaderId);
                if (loaderEl) loaderEl.remove();

                if (data.success) {
                    appendMessage('CHIEF OF STAFF // MONTY 2', data.output, 'monty');
                } else {
                    appendMessage('SYSTEM ERROR', data.error || 'Failed to reach node backend.', 'system-error');
                }
            } catch (err) {
                clearInterval(timerInterval);
                const loaderEl = document.getElementById(loaderId);
                if (loaderEl) loaderEl.remove();

                appendMessage('SYSTEM ERROR', err.message, 'system-error');
            }
        }

        document.getElementById('btnSubmit').addEventListener('click', submitPrompt);
        
        promptInput.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                submitPrompt();
            }
        });

        document.getElementById('btnCls').addEventListener('click', () => {
            promptInput.value = '';
            terminalViewport.innerHTML = `
                <div class="system-status-msg">
                    <strong style="color: var(--gold-core);">CHIEF OF STAFF // MONTY 2 (BASE 1 PIPELINE)</strong>
                    <div class="system-status-sub">
                        Terminal buffer cleared. Active pipeline: ${state.modelLabel}. Awaiting raw instructions.
                    </div>
                </div>
            `;
        });
    });
</script>