    <!-- LEFT SIDEBAR -->
    <aside class="sidebar-left">
        <div class="sidebar-header">Left-Hand Menu</div>

        <div class="accordion-item">
            <div class="accordion-title">
                MONTY'S BRAIN <span>▼</span>
            </div>

            <div class="tier-group">
                <div class="tier-label">TIER 1: OLLAMA (LOCAL)</div>
