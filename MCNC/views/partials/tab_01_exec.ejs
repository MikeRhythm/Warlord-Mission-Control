<style>
    /* ==========================================================================
       WARLORD 01 EXEC COMPONENT STYLES
       ========================================================================== */
    .main-container { display: flex; flex: 1; height: 100%; width: 100%; overflow: hidden; }
    
    .sidebar-left { width: 280px; min-width: 280px; background-color: var(--bg-obsidian); border-right: 1px solid var(--border-dim); display: flex; flex-direction: column; padding: 12px; gap: 16px; overflow-y: auto; }
    .sidebar-header { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; color: var(--gold-core); text-transform: uppercase; padding-bottom: 6px; border-bottom: 1px solid var(--border-dim); }
    
    .accordion-item { display: flex; flex-direction: column; gap: 8px; }
    .accordion-title { background-color: var(--glass-panel); border: 1px solid var(--border-dim); color: var(--gold-core); padding: 8px 12px; font-size: 12px; font-weight: bold; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    
    .tier-group { display: flex; flex-direction: column; gap: 6px; padding-left: 4px; }
    .tier-label { font-size: 10px; color: var(--text-mist); letter-spacing: 0.8px; margin-top: 6px; text-transform: uppercase; }
    
    .model-btn { background-color: rgba(15, 23, 42, 0.4); border: 1px solid var(--border-dim); color: var(--text-glint); padding: 8px 10px; font-size: 11px; font-family: 'JetBrains Mono', monospace; text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: all 0.15s ease; }
    .model-btn:hover { border-color: var(--text-glint); background-color: rgba(15, 23, 42, 0.8); }
    .model-btn.active { border-color: var(--emerald-core); color: var(--emerald-core); background-color: var(--glass-emerald); box-shadow: 0 0 6px rgba(16, 185, 129, 0.2); }
    
    .badge-tag { font-size: 9px; padding: 2px 5px; border-radius: 2px; background-color: rgba(0,0,0,0.2); color: var(--text-mist); border: 1px solid var(--border-dim); }
    .model-btn.active .badge-tag { border-color: var(--emerald-core); color: var(--emerald-core); }
    
    .workspace-main { flex: 1; display: flex; flex-direction: column; background-color: transparent; overflow: hidden; }
    .pipeline-banner { background-color: var(--glass-panel); border-bottom: 1px solid var(--border-dim); padding: 8px 16px; font-size: 11px; color: #38bdf8; letter-spacing: 1px; text-align: right; text-transform: uppercase; }
    
    .terminal-viewport { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; scroll-behavior: smooth; }
    .system-status-msg { font-size: 13px; line-height: 1.6; margin-bottom: 10px; }
    .system-status-sub { color: var(--text-mist); font-size: 12px; line-height: 1.5; margin-top: 4px; }
    
    .bottom-deck { background-color: var(--bg-obsidian); border-top: 1px solid var(--border-dim); padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }
    .attachment-bar { display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--emerald-core); cursor: pointer; }
    
    .mcnc-prompt-wrapper { display: flex; gap: 10px; align-items: flex-start; }
    .prompt-textarea { flex: 1; min-height: 70px; max-height: 200px; background-color: var(--bg-obsidian); border: 1px solid var(--border-dim); color: var(--text-glint); font-family: 'JetBrains Mono', monospace; font-size: 13px; padding: 10px 12px; outline: none; resize: vertical; }
    
    .warlord-mic-btn { background-color: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-dim); color: var(--text-glint); width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; border-radius: 4px; }
    .warlord-mic-btn:hover { border-color: var(--emerald-core); color: var(--emerald-core); }
    .warlord-mic-btn svg { width: 24px; height: 24px; fill: currentColor; }
    .warlord-mic-btn.recording { color: var(--ruby-core); border-color: var(--ruby-core); animation: micPulse 1.5s infinite; }

    .control-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .toolbar-group-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    
    .action-btn { background-color: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-dim); color: var(--text-glint); padding: 6px 14px; font-size: 11px; font-family: 'JetBrains Mono', monospace; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; cursor: pointer; transition: all 0.15s ease; }
    .action-btn:hover { background-color: rgba(255, 255, 255, 0.05); border-color: var(--text-glint); }
    .action-btn.btn-submit { border-color: var(--gold-core); color: var(--gold-core); }
    .action-btn.btn-submit:hover { background-color: rgba(218, 165, 32, 0.15); box-shadow: 0 0 8px rgba(218, 165, 32, 0.3); }
    .action-btn.btn-approve { border-color: var(--emerald-core); color: var(--emerald-core); }
    .action-btn.btn-approve:hover { background-color: var(--glass-emerald); }
    .action-btn.btn-cls { border-color: var(--ruby-core); color: var(--ruby-core); }
    .action-btn.btn-cls:hover { background-color: var(--glass-ruby); }
    
    .project-select { background-color: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-dim); color: var(--gold-core); padding: 6px 10px; font-size: 11px; font-family: 'JetBrains Mono', monospace; font-weight: bold; outline: none; cursor: pointer; }
    .status-pill { background-color: var(--glass-panel); border: 1px solid var(--emerald-core); color: var(--emerald-core); padding: 6px 12px; font-size: 10px; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase; }

    /* ==========================================================================
       HEAVY TACTICAL LOADER MODULE
       ========================================================================== */
    .heavy-loader-block {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; padding: 40px;
        background: rgba(15, 23, 42, 0.7); border: 2px solid rgba(218, 165, 32, 0.3); border-radius: 4px; margin: 20px 0;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(218, 165, 32, 0.05);
    }
    .massive-spinner {
        width: 72px; height: 72px; border-radius: 50%; border: 4px solid var(--border-dim);
        border-top-color: var(--gold-core); border-bottom-color: var(--gold-core); animation: spinHeavy 1.2s ease-in-out infinite;
    }
    @keyframes spinHeavy { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    @keyframes pulseGlow { 0% { opacity: 0.7; text-shadow: 0 0 5px var(--gold-core); } 50% { opacity: 1; text-shadow: 0 0 15px var(--gold-core); } 100% { opacity: 0.7; text-shadow: 0 0 5px var(--gold-core); } }
    @keyframes micPulse { 0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); } 100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); } }
    
    .heavy-loader-text {
        color: var(--gold-core); font-size: 16px; font-family: 'JetBrains Mono', monospace; font-weight: bold;
        letter-spacing: 2px; text-transform: uppercase; animation: pulseGlow 1.5s infinite; text-align: center;
    }
</style>

<!-- MAIN CONTAINER -->
