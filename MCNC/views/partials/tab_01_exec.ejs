            <div class="attachment-preview-container" id="attachmentPreview"></div>

            <!-- GLOBAL WARLORD DICTATION HOOK (WEB SPEECH API) -->
            <div class="mcnc-prompt-wrapper">
                <textarea 
                    id="execPromptInput" 
