<div class="tab-pane" id="tab-taskboard">
  <div class="kanban-metrics flex justify-around p-4 border border-[#1f242d] bg-[#0c0e12] rounded mb-4 font-mono text-xs">
    <div class="text-center"><span class="block text-lg font-bold text-[#10b981]" id="metric-daemons">0</span><span class="text-gray-400">ACTIVE DAEMONS</span></div>
    <div class="text-center"><span class="block text-lg font-bold text-[#3b82f6]" id="metric-building">0</span><span class="text-gray-400">BUILDING</span></div>
    <div class="text-center"><span class="block text-lg font-bold text-[#ffb800]" id="metric-gate">0</span><span class="text-gray-400">HUMAN GATE</span></div>
    <div class="text-center"><span class="block text-lg font-bold text-[#10b981]" id="metric-shipped">0</span><span class="text-gray-400">TOTAL SHIPPED</span></div>
  </div>

  <div class="kanban-grid grid grid-cols-1 md:grid-cols-4 gap-4 font-mono">
    <div class="column bg-[#0a0c10] border border-[#1f242d] rounded p-3">
      <div class="flex justify-between items-center mb-3 pb-2 border-b border-[#1f242d]">
        <span class="text-xs text-gray-300 font-bold tracking-wide">CAPTURE &amp; PLAN</span>
        <span class="text-xs text-gray-500" id="count-capture">0</span>
      </div>
      <div id="column-capture" class="column-cards flex flex-col gap-2 min-h-[300px]"></div>
    </div>

    <div class="column bg-[#0a0c10] border border-[#1f242d] rounded p-3">
      <div class="flex justify-between items-center mb-3 pb-2 border-b border-[#1f242d]">
        <span class="text-xs text-blue-400 font-bold tracking-wide">AGENT BUILD</span>
        <span class="text-xs text-gray-500" id="count-build">0</span>
      </div>
      <div id="column-build" class="column-cards flex flex-col gap-2 min-h-[300px]"></div>
    </div>

    <div class="column bg-[#0a0c10] border border-[#1f242d] rounded p-3">
      <div class="flex justify-between items-center mb-3 pb-2 border-b border-[#1f242d]">
        <span class="text-xs text-[#ffb800] font-bold tracking-wide">HUMAN GATE</span>
        <span class="text-xs text-gray-500" id="count-gate">0</span>
      </div>
      <div id="column-gate" class="column-cards flex flex-col gap-2 min-h-[300px]"></div>
    </div>

    <div class="column bg-[#0a0c10] border border-[#1f242d] rounded p-3">
      <div class="flex justify-between items-center mb-3 pb-2 border-b border-[#1f242d]">
        <span class="text-xs text-[#10b981] font-bold tracking-wide">SHIPPED</span>
        <span class="text-xs text-gray-500" id="count-shipped">0</span>
      </div>
      <div id="column-shipped" class="column-cards flex flex-col gap-2 min-h-[300px]"></div>
    </div>
  </div>
</div>
