<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:background w:color="F7F3E8"/><w:body><w:p w14:paraId="2B716C63" w14:textId="77777777" w:rsidR="00200CAD" w:rsidRDefault="00200CAD" w:rsidP="00E9126E"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="70036936" w14:textId="77777777" w:rsidR="00300A67" w:rsidRDefault="00300A67" w:rsidP="00E9126E"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="5D0868EF" w14:textId="77777777" w:rsidR="00300A67" w:rsidRDefault="00300A67" w:rsidP="00E9126E"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="10B62FCD" w14:textId="77777777" w:rsidR="00300A67" w:rsidRDefault="00300A67" w:rsidP="00E9126E"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="397301B5" w14:textId="4EECC20B" w:rsidR="00E9126E" w:rsidRDefault="00E9126E" w:rsidP="00300A67"><w:pPr><w:spacing w:after="0"/><w:jc w:val="center"/></w:pPr></w:p><w:p w14:paraId="2AA4CB83" w14:textId="77777777" w:rsidR="00E9126E" w:rsidRDefault="00E9126E" w:rsidP="00E9126E"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="7984F0B9" w14:textId="77777777" w:rsidR="00E9126E" w:rsidRDefault="00E9126E" w:rsidP="00E9126E"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="0CE34C2E" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve"># The Chief </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Madothi</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Children's School and Feeding Fund – Master Prompt</w:t></w:r></w:p><w:p w14:paraId="06EE40B4" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="7D34F182" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Purpose</w:t></w:r></w:p><w:p w14:paraId="73220A4D" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>The Fund is dedicated to providing nutritious meals and quality education for vulnerable and underprivileged children in rural and township communities, starting in South Africa and expanding across the region.</w:t></w:r></w:p><w:p w14:paraId="7BF21265" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="10B8B896" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="198E0AC4" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="793FC47C" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Mission Statement</w:t></w:r></w:p><w:p w14:paraId="1E61CD99" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>To ensure that every child in need receives both nourishment and the opportunity for learning in a safe, nurturing, and dignified environment.</w:t></w:r></w:p><w:p w14:paraId="2919267F" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="44E6ADA7" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="60A0BF80" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="11DF778E" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Key Objectives</w:t></w:r></w:p><w:p w14:paraId="44FA4532" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">1. Establish and support sustainable feeding programs linked to local schools and community centers.  </w:t></w:r></w:p><w:p w14:paraId="503D7B5C" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">2. Build and maintain the Chief </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Madothi</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Children’s School and Feeding Centre as a flagship model.  </w:t></w:r></w:p><w:p w14:paraId="61B25D59" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">3. Partner with **Faith &amp; Spiritual Networks**, community leaders, and local governments to strengthen outreach.  </w:t></w:r></w:p><w:p w14:paraId="12B412E0" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">4. Develop self-sustaining food gardens, kitchens, and learning spaces powered by local participation.  </w:t></w:r></w:p><w:p w14:paraId="2144D24D" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>5. Ensure transparency, accountability, and measurable impact in all fund operations.</w:t></w:r></w:p><w:p w14:paraId="68448CEB" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="28DEEF03" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="0B83FF30" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="61E197A5" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Core Values</w:t></w:r></w:p><w:p w14:paraId="26839286" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Compassion and dignity**  </w:t></w:r></w:p><w:p w14:paraId="2098E2A4" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Sustainability and local empowerment**  </w:t></w:r></w:p><w:p w14:paraId="243B7DC1" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Integrity and transparency**  </w:t></w:r></w:p><w:p w14:paraId="1954163B" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>- **Education and opportunity for all**</w:t></w:r></w:p><w:p w14:paraId="49E582FD" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="04DF0E89" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="7C3D6373" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="5A1D3022" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Implementation Strategy</w:t></w:r></w:p><w:p w14:paraId="2CCC5DD9" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">The Fund will operate through a hybrid structure combining charitable donations, community partnerships, and income-generating projects.  </w:t></w:r></w:p><w:p w14:paraId="37390AF9" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Each program will be designed for scalability, sustainability, and measurable community benefit.</w:t></w:r></w:p><w:p w14:paraId="2266D4B1" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="5DFA42CC" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="64E1644C" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="35D1AFCC" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Governance</w:t></w:r></w:p><w:p w14:paraId="4851E612" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>A board of trustees and community advisory group will oversee operations, ensuring all funds are used responsibly and for their intended purpose.</w:t></w:r></w:p><w:p w14:paraId="08F42CE4" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="1A6ACCF8" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="0E460B08" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="3021E994" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Design and Brand Notes</w:t></w:r></w:p><w:p w14:paraId="200AAB09" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Color Palette:** Warm earthy tones inspired by the African landscape — **sunset oranges, deep ochres, and rich browns**, accented by **natural greens** representing growth and renewal.  </w:t></w:r></w:p><w:p w14:paraId="54502AB2" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Visual Identity:** Rooted in African warmth and heritage, with design elements inspired by **sunrise, community, and unity**.  </w:t></w:r></w:p><w:p w14:paraId="2282D1DF" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Tone:** Sincere, compassionate, hopeful, and grounded in authenticity.  </w:t></w:r></w:p><w:p w14:paraId="0FBA1E5F" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Imagery:** Focus on **children, community, sunlight, and food** — highlighting the connection between nourishment and education.  </w:t></w:r></w:p><w:p w14:paraId="722BEB7D" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Typography:** Clean, modern sans-serif fonts paired with warm, humanist typefaces that feel welcoming yet professional.  </w:t></w:r></w:p><w:p w14:paraId="19F61778" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>- **Logo Usage:** The official logo should always maintain the balance of **heritage, humility, and hope**, with consistent color and spacing.</w:t></w:r></w:p><w:p w14:paraId="10EF1038" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="3E4DDB9B" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="4BEEAA0A" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="1DFE2E95" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Creative Direction</w:t></w:r></w:p><w:p w14:paraId="3B4DC1A7" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">The overall aesthetic and storytelling approach should express the **soul and warmth of Africa** — a deep sense of belonging, community, and purpose.  </w:t></w:r></w:p><w:p w14:paraId="310AEE00" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>Every visual and written element should feel alive with **sunlight, kindness, and resilience**.</w:t></w:r></w:p><w:p w14:paraId="0B5930AC" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="77ACF293" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Emotional Tone:** Inspiring yet humble; proud but not flashy. It should feel like a shared journey rather than a campaign.  </w:t></w:r></w:p><w:p w14:paraId="40E2E52B" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Cultural Expression:** Subtle African motifs, fabrics, or textures can be incorporated, always with respect and authenticity.  </w:t></w:r></w:p><w:p w14:paraId="5B7E6E86" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Lighting &amp; Atmosphere:** Evoke the **golden hues of sunrise and sunset** — symbols of renewal, hope, and nourishment.  </w:t></w:r></w:p><w:p w14:paraId="1C62E499" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">- **Voice:** Warm, direct, and human, avoiding corporate jargon.  </w:t></w:r></w:p><w:p w14:paraId="18E873DD" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>- **Personality Keywords:** *Empathy, Growth, Warmth, Light, Togetherness, Hope.*</w:t></w:r></w:p><w:p w14:paraId="28B19431" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="3F8EEA67" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>In essence, all work related to the Fund — from visual identity to digital communication — should reflect **Ubuntu**: *“I am because we are.”*</w:t></w:r></w:p><w:p w14:paraId="68C339A6" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="2487730B" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>---</w:t></w:r></w:p><w:p w14:paraId="7B552963" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="0D21A43E" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t>## Official Name</w:t></w:r></w:p><w:p w14:paraId="5EA699F1" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">For all official documents, communications, and materials, the correct name to be used is:  </w:t></w:r></w:p><w:p w14:paraId="386C8DF7" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:t xml:space="preserve">**The Chief </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Madothi</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Children’s School and Feeding Fund**</w:t></w:r></w:p><w:p w14:paraId="378F0749" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDefault="002C112F" w:rsidP="002C112F"><w:pPr><w:spacing w:after="0"/></w:pPr></w:p><w:p w14:paraId="05174B19" w14:textId="77777777" w:rsidR="002C112F" w:rsidRDef